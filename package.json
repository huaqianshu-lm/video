{
  "name": "remotion-ai-video",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preview": "node harness/src/cli.mjs render-input entry-all --output src/RenderInputRoot.tsx && remotion studio src/RenderInputRoot.tsx",
    "check": "tsc --noEmit",
    "render": "remotion render video-production-template out/video-production-template.mp4",
    "harness:web": "npm run web --prefix harness"
  },
  "dependencies": {
    "@remotion/cli": "latest",
    "remotion": "latest",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "typescript": "~5.8.3"
  }
}
