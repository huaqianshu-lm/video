{
  "schemaVersion": "1.0",
  "videoId": "desktop",
  "scenes": [
    {
      "sceneId": "01",
      "file": "subtitles/scene-01.json",
      "segments": [
        {
          "segmentId": "01-01",
          "audioFile": "audio/scene-01/01-01.mp3",
          "cues": [
            {
              "id": "01-01-a",
              "text": "很多人一听桌面 app，",
              "start": 0.09,
              "end": 1.87
            },
            {
              "id": "01-01-b",
              "text": "第一反应是：这不就是给小白用的简化版吗",
              "start": 1.87,
              "end": 5.02
            },
            {
              "id": "01-01-c",
              "text": "但当你同时推进三个互不相干的任务，",
              "start": 5.02,
              "end": 7.7
            },
            {
              "id": "01-01-d",
              "text": "在终端开三个 tab，",
              "start": 7.7,
              "end": 9.14
            },
            {
              "id": "01-01-e",
              "text": "改着改着就会发现，",
              "start": 9.14,
              "end": 10.69
            },
            {
              "id": "01-01-f",
              "text": "真正让人混乱的不是命令行，",
              "start": 10.69,
              "end": 12.91
            },
            {
              "id": "01-01-g",
              "text": "而是三个会话正在共享同一份工作目录",
              "start": 12.91,
              "end": 15.9
            },
            {
              "id": "01-01-h",
              "text": "桌面 app 解决的，",
              "start": 15.9,
              "end": 17.16
            },
            {
              "id": "01-01-i",
              "text": "是另一种工作方式",
              "start": 17.16,
              "end": 18.768
            }
          ]
        }
      ]
    },
    {
      "sceneId": "02",
      "file": "subtitles/scene-02.json",
      "segments": [
        {
          "segmentId": "02-01",
          "audioFile": "audio/scene-02/02-01.mp3",
          "cues": [
            {
              "id": "02-01-a",
              "text": "先把边界分清楚",
              "start": 0.09,
              "end": 1.79
            },
            {
              "id": "02-01-b",
              "text": "桌面 app 里的 Chat 是普通对话，",
              "start": 1.79,
              "end": 4.04
            },
            {
              "id": "02-01-c",
              "text": "Cowork 处理的是云端代理任务，",
              "start": 4.04,
              "end": 6.19
            },
            {
              "id": "02-01-d",
              "text": "只有 Code 才是直接读写本地项目的 Claude Code",
              "start": 6.19,
              "end": 9.74
            },
            {
              "id": "02-01-e",
              "text": "它和终端里的 `claude` 使用同一个底层引擎，",
              "start": 9.74,
              "end": 12.57
            },
            {
              "id": "02-01-f",
              "text": "只是把操作放进了带侧边栏和窗格的图形界面里",
              "start": 12.57,
              "end": 16.368
            }
          ]
        }
      ]
    },
    {
      "sceneId": "03",
      "file": "subtitles/scene-03.json",
      "segments": [
        {
          "segmentId": "03-01",
          "audioFile": "audio/scene-03/03-01.mp3",
          "cues": [
            {
              "id": "03-01-a",
              "text": "使用前先看三个门槛",
              "start": 0.09,
              "end": 2.1
            },
            {
              "id": "03-01-b",
              "text": "桌面 app 目前支持 macOS 和 Windows，",
              "start": 2.1,
              "end": 4.99
            },
            {
              "id": "03-01-c",
              "text": "Linux 没有桌面 app，",
              "start": 4.99,
              "end": 6.56
            },
            {
              "id": "03-01-d",
              "text": "只能直接用 CLI",
              "start": 6.56,
              "end": 8.41
            },
            {
              "id": "03-01-e",
              "text": "Code 选项卡还需要 Pro、",
              "start": 8.41,
              "end": 10.11
            },
            {
              "id": "03-01-f",
              "text": "Max、Team 或 Enterprise 订阅",
              "start": 10.11,
              "end": 12.5
            },
            {
              "id": "03-01-g",
              "text": "macOS 下载 Universal 版就可以，",
              "start": 12.5,
              "end": 14.92
            },
            {
              "id": "03-01-h",
              "text": "Windows 要按处理器选择安装包，",
              "start": 14.92,
              "end": 17.18
            },
            {
              "id": "03-01-i",
              "text": "并先装 Git；装完记得重启应用，",
              "start": 17.18,
              "end": 19.62
            },
            {
              "id": "03-01-j",
              "text": "否则本地会话可能起不来",
              "start": 19.62,
              "end": 21.72
            }
          ]
        }
      ]
    },
    {
      "sceneId": "04",
      "file": "subtitles/scene-04.json",
      "segments": [
        {
          "segmentId": "04-01",
          "audioFile": "audio/scene-04/04-01.mp3",
          "cues": [
            {
              "id": "04-01-a",
              "text": "桌面 app 最值得用的地方，",
              "start": 0.09,
              "end": 1.92
            },
            {
              "id": "04-01-b",
              "text": "是并行会话的隔离",
              "start": 1.92,
              "end": 3.63
            },
            {
              "id": "04-01-c",
              "text": "点击侧边栏的加号，",
              "start": 3.63,
              "end": 5.07
            },
            {
              "id": "04-01-d",
              "text": "新会话会在 Git 仓库里自动拉出独立的 worktree",
              "start": 5.07,
              "end": 8.81
            },
            {
              "id": "04-01-e",
              "text": "登录修复、测试补充和工具函数重构可以同时",
              "start": 8.81,
              "end": 12.22
            },
            {
              "id": "04-01-f",
              "text": "进行，每个会话各改各的，",
              "start": 12.22,
              "end": 14.2
            },
            {
              "id": "04-01-g",
              "text": "改动不会互相污染",
              "start": 14.2,
              "end": 15.92
            },
            {
              "id": "04-01-h",
              "text": "你只需要从侧边栏切换，",
              "start": 15.92,
              "end": 17.72
            },
            {
              "id": "04-01-i",
              "text": "或者把两个会话并排打开",
              "start": 17.72,
              "end": 19.896
            }
          ]
        }
      ]
    },
    {
      "sceneId": "05",
      "file": "subtitles/scene-05.json",
      "segments": [
        {
          "segmentId": "05-01",
          "audioFile": "audio/scene-05/05-01.mp3",
          "cues": [
            {
              "id": "05-01-a",
              "text": "同一个会话里，聊天、",
              "start": 0.09,
              "end": 1.76
            },
            {
              "id": "05-01-b",
              "text": "终端和文件编辑器也能放在一起",
              "start": 1.76,
              "end": 4.68
            },
            {
              "id": "05-01-c",
              "text": "集成终端就在当前会话的工作目录里，",
              "start": 4.68,
              "end": 7.43
            },
            {
              "id": "05-01-d",
              "text": "所以你跑 `npm test` 或 `git status`，",
              "start": 7.43,
              "end": 10.09
            },
            {
              "id": "05-01-e",
              "text": "看到的就是 Claude 正在改的那一份文件",
              "start": 10.09,
              "end": 13.15
            },
            {
              "id": "05-01-f",
              "text": "点聊天或 diff 里的文件路径，",
              "start": 13.15,
              "end": 15.3
            },
            {
              "id": "05-01-g",
              "text": "还能直接打开、修改并保存；",
              "start": 15.3,
              "end": 17.6
            },
            {
              "id": "05-01-h",
              "text": "如果磁盘上的文件被别处改过，",
              "start": 17.6,
              "end": 19.76
            },
            {
              "id": "05-01-i",
              "text": "界面会先提醒你",
              "start": 19.76,
              "end": 21.432
            }
          ]
        }
      ]
    },
    {
      "sceneId": "06",
      "file": "subtitles/scene-06.json",
      "segments": [
        {
          "segmentId": "06-01",
          "audioFile": "audio/scene-06/06-01.mp3",
          "cues": [
            {
              "id": "06-01-a",
              "text": "图形界面带来的另一个提升，",
              "start": 0.09,
              "end": 2.01
            },
            {
              "id": "06-01-b",
              "text": "是改动终于变得好审阅",
              "start": 2.01,
              "end": 3.99
            },
            {
              "id": "06-01-c",
              "text": "文件改完后，点开增删行指示器，",
              "start": 3.99,
              "end": 6.47
            },
            {
              "id": "06-01-d",
              "text": "就能看到完整 diff",
              "start": 6.47,
              "end": 8.14
            },
            {
              "id": "06-01-e",
              "text": "你可以直接点某一行写批注，",
              "start": 8.14,
              "end": 10.09
            },
            {
              "id": "06-01-f",
              "text": "提交后让 Claude 按批注继续改，",
              "start": 10.09,
              "end": 12.49
            },
            {
              "id": "06-01-g",
              "text": "也可以先点 Review code，",
              "start": 12.49,
              "end": 14.09
            },
            {
              "id": "06-01-h",
              "text": "让它自己找高信号的问题",
              "start": 14.09,
              "end": 16.18
            },
            {
              "id": "06-01-i",
              "text": "最后，改动是否接受，",
              "start": 16.18,
              "end": 17.93
            },
            {
              "id": "06-01-j",
              "text": "仍然由你决定",
              "start": 17.93,
              "end": 19.296
            }
          ]
        }
      ]
    },
    {
      "sceneId": "07",
      "file": "subtitles/scene-07.json",
      "segments": [
        {
          "segmentId": "07-01",
          "audioFile": "audio/scene-07/07-01.mp3",
          "cues": [
            {
              "id": "07-01-a",
              "text": "所以 Desktop 不是 CLI 或 IDE 扩展的替代品",
              "start": 0.09,
              "end": 4.07
            },
            {
              "id": "07-01-b",
              "text": "需要脚本、自动化和终端原生能力，",
              "start": 4.07,
              "end": 6.79
            },
            {
              "id": "07-01-c",
              "text": "就用 CLI；",
              "start": 6.79,
              "end": 8.14
            },
            {
              "id": "07-01-d",
              "text": "主力工作在熟悉的编辑器里，",
              "start": 8.14,
              "end": 10.05
            },
            {
              "id": "07-01-e",
              "text": "就用 VS Code 或 JetBrains 扩展；",
              "start": 10.05,
              "end": 12.69
            },
            {
              "id": "07-01-f",
              "text": "要同时推进多个独立任务，",
              "start": 12.69,
              "end": 14.51
            },
            {
              "id": "07-01-g",
              "text": "并且希望可视化审阅，",
              "start": 14.51,
              "end": 16.05
            },
            {
              "id": "07-01-h",
              "text": "就用 Desktop",
              "start": 16.05,
              "end": 17.5
            },
            {
              "id": "07-01-i",
              "text": "它们共享配置和底层能力，",
              "start": 17.5,
              "end": 19.39
            },
            {
              "id": "07-01-j",
              "text": "区别只是最适合的工作场景",
              "start": 19.39,
              "end": 21.768
            }
          ]
        }
      ]
    },
    {
      "sceneId": "08",
      "file": "subtitles/scene-08.json",
      "segments": [
        {
          "segmentId": "08-01",
          "audioFile": "audio/scene-08/08-01.mp3",
          "cues": [
            {
              "id": "08-01-a",
              "text": "第一次使用时，选择 Local、",
              "start": 0.09,
              "end": 2.03
            },
            {
              "id": "08-01-b",
              "text": "项目文件夹、模型和默认的询问权限模式",
              "start": 2.03,
              "end": 5.51
            },
            {
              "id": "08-01-c",
              "text": "然后发一个小任务，",
              "start": 5.51,
              "end": 6.89
            },
            {
              "id": "08-01-d",
              "text": "比如找一条 TODO，",
              "start": 6.89,
              "end": 8.22
            },
            {
              "id": "08-01-e",
              "text": "把它修掉。Claude 处理时会显示进度和 diff，",
              "start": 8.22,
              "end": 11.72
            },
            {
              "id": "08-01-f",
              "text": "你先看清楚，再决定接受还是拒绝；",
              "start": 11.72,
              "end": 14.47
            },
            {
              "id": "08-01-g",
              "text": "在你点击接受之前，",
              "start": 14.47,
              "end": 15.91
            },
            {
              "id": "08-01-h",
              "text": "磁盘上的文件不会被改动",
              "start": 15.91,
              "end": 18.19
            },
            {
              "id": "08-01-i",
              "text": "如果终端会话聊到一半想换到桌面，",
              "start": 18.19,
              "end": 20.78
            },
            {
              "id": "08-01-j",
              "text": "在 CLI 里输入 `/desktop` 就可以继续",
              "start": 20.78,
              "end": 23.808
            }
          ]
        }
      ]
    },
    {
      "sceneId": "09",
      "file": "subtitles/scene-09.json",
      "segments": [
        {
          "segmentId": "09-01",
          "audioFile": "audio/scene-09/09-01.mp3",
          "cues": [
            {
              "id": "09-01-a",
              "text": "把这篇记成一句话：",
              "start": 0.09,
              "end": 1.49
            },
            {
              "id": "09-01-b",
              "text": "桌面 app 的价值，",
              "start": 1.49,
              "end": 2.69
            },
            {
              "id": "09-01-c",
              "text": "是用 Git 隔离并行会话，",
              "start": 2.69,
              "end": 4.54
            },
            {
              "id": "09-01-d",
              "text": "用共享窗格减少来回切换，",
              "start": 4.54,
              "end": 6.65
            },
            {
              "id": "09-01-e",
              "text": "再用可视化 diff 把审阅放到眼前",
              "start": 6.65,
              "end": 9.41
            },
            {
              "id": "09-01-f",
              "text": "自动化回 CLI，",
              "start": 9.41,
              "end": 10.94
            },
            {
              "id": "09-01-g",
              "text": "熟悉编辑器用 IDE，",
              "start": 10.94,
              "end": 12.55
            },
            {
              "id": "09-01-h",
              "text": "并行和审阅选 Desktop",
              "start": 12.55,
              "end": 14.67
            },
            {
              "id": "09-01-i",
              "text": "下一篇我们继续看网页版与云端，",
              "start": 14.67,
              "end": 17.17
            },
            {
              "id": "09-01-j",
              "text": "包括 Remote 环境和手机上查看进度这件事",
              "start": 17.17,
              "end": 20.688
            }
          ]
        }
      ]
    }
  ]
}
