{
  "schemaVersion": "1.0",
  "videoId": "project-init",
  "scenes": [
    {
      "sceneId": "01",
      "file": "subtitles/scene-01.json",
      "segments": [
        {
          "segmentId": "01-01",
          "audioFile": "audio/scene-01/01-01.mp3",
          "cues": [
            {
              "id": "01-01-a",
              "text": "刚接手一个之前同事留下的 Node 项目，",
              "start": 0.09,
              "end": 2.74
            },
            {
              "id": "01-01-b",
              "text": "没跑 /init 就直接开干",
              "start": 2.74,
              "end": 4.95
            },
            {
              "id": "01-01-c",
              "text": "第一次问测试怎么跑，",
              "start": 4.95,
              "end": 6.41
            },
            {
              "id": "01-01-d",
              "text": "它翻了一圈 package",
              "start": 6.41,
              "end": 7.82
            },
            {
              "id": "01-01-e",
              "text": "json 才回答你",
              "start": 7.82,
              "end": 9.77
            },
            {
              "id": "01-01-f",
              "text": "过了二十分钟开个新会话，",
              "start": 9.77,
              "end": 11.78
            },
            {
              "id": "01-01-g",
              "text": "同样的问题它又从头翻一遍",
              "start": 11.78,
              "end": 14.14
            },
            {
              "id": "01-01-h",
              "text": "下午换个任务，它第三次问你，",
              "start": 14.14,
              "end": 16.37
            },
            {
              "id": "01-01-i",
              "text": "这个项目到底用的是 npm 还是 pnpm",
              "start": 16.37,
              "end": 19.728
            }
          ]
        }
      ]
    },
    {
      "sceneId": "02",
      "file": "subtitles/scene-02.json",
      "segments": [
        {
          "segmentId": "02-01",
          "audioFile": "audio/scene-02/02-01.mp3",
          "cues": [
            {
              "id": "02-01-a",
              "text": "这时候别急着说它笨",
              "start": 0.09,
              "end": 2.04
            },
            {
              "id": "02-01-b",
              "text": "真正的问题是，你没有给它一份项目说明书",
              "start": 2.04,
              "end": 5.14
            },
            {
              "id": "02-01-c",
              "text": "每个新会话都要重新摸索项目，",
              "start": 5.14,
              "end": 7.47
            },
            {
              "id": "02-01-d",
              "text": "当然会不断重复查找",
              "start": 7.47,
              "end": 9.32
            },
            {
              "id": "02-01-e",
              "text": "CLAUDE.md 就像写给 Claude 看的入职手册，",
              "start": 9.32,
              "end": 12.56
            },
            {
              "id": "02-01-f",
              "text": "把项目架构、命令和约定放在一个固定位置",
              "start": 12.56,
              "end": 16.008
            }
          ]
        }
      ]
    },
    {
      "sceneId": "03",
      "file": "subtitles/scene-03.json",
      "segments": [
        {
          "segmentId": "03-01",
          "audioFile": "audio/scene-03/03-01.mp3",
          "cues": [
            {
              "id": "03-01-a",
              "text": "init 就是帮你起草这份说明书的内置命令",
              "start": 0.09,
              "end": 3.42
            },
            {
              "id": "03-01-b",
              "text": "它会先分析你的代码库，",
              "start": 3.42,
              "end": 5.21
            },
            {
              "id": "03-01-c",
              "text": "再生成一份 CLAUDE.md 草稿",
              "start": 5.21,
              "end": 7.67
            },
            {
              "id": "03-01-d",
              "text": "它做的事情可以概括成一句话：",
              "start": 7.67,
              "end": 9.94
            },
            {
              "id": "03-01-e",
              "text": "把 Claude 每次重新认识你的项目，",
              "start": 9.94,
              "end": 12.47
            },
            {
              "id": "03-01-f",
              "text": "变成认识一次、长期有一份起点上下文",
              "start": 12.47,
              "end": 15.552
            }
          ]
        }
      ]
    },
    {
      "sceneId": "04",
      "file": "subtitles/scene-04.json",
      "segments": [
        {
          "segmentId": "04-01",
          "audioFile": "audio/scene-04/04-01.mp3",
          "cues": [
            {
              "id": "04-01-a",
              "text": "用它很简单",
              "start": 0.09,
              "end": 1.39
            },
            {
              "id": "04-01-b",
              "text": "第一步，进入项目根目录，",
              "start": 1.39,
              "end": 3.24
            },
            {
              "id": "04-01-c",
              "text": "别在桌面或主目录里直接启动",
              "start": 3.24,
              "end": 5.98
            },
            {
              "id": "04-01-d",
              "text": "第二步，运行 claude",
              "start": 5.98,
              "end": 7.78
            },
            {
              "id": "04-01-e",
              "text": "第三步，在输入框里敲 /init，",
              "start": 7.78,
              "end": 10
            },
            {
              "id": "04-01-f",
              "text": "回车。接下来就让 Claude 自己分析",
              "start": 10,
              "end": 12.83
            },
            {
              "id": "04-01-g",
              "text": "和写入文件",
              "start": 12.83,
              "end": 14.064
            }
          ]
        }
      ]
    },
    {
      "sceneId": "05",
      "file": "subtitles/scene-05.json",
      "segments": [
        {
          "segmentId": "05-01",
          "audioFile": "audio/scene-05/05-01.mp3",
          "cues": [
            {
              "id": "05-01-a",
              "text": "它不是凭空写这份文件",
              "start": 0.09,
              "end": 2.06
            },
            {
              "id": "05-01-b",
              "text": "依赖清单可以帮助它判断技术栈和可运行的命令，",
              "start": 2.06,
              "end": 5.56
            },
            {
              "id": "05-01-c",
              "text": "README 这类文档帮助它理解项目是做什么的，",
              "start": 5.56,
              "end": 8.49
            },
            {
              "id": "05-01-d",
              "text": "配置文件和代码结构则帮助它摸清目录怎么分、",
              "start": 8.49,
              "end": 11.95
            },
            {
              "id": "05-01-e",
              "text": "入口在哪里",
              "start": 11.95,
              "end": 13.2
            },
            {
              "id": "05-01-f",
              "text": "它把这些看得见的事实整理成草稿",
              "start": 13.2,
              "end": 16.104
            }
          ]
        }
      ]
    },
    {
      "sceneId": "06",
      "file": "subtitles/scene-06.json",
      "segments": [
        {
          "segmentId": "06-01",
          "audioFile": "audio/scene-06/06-01.mp3",
          "cues": [
            {
              "id": "06-01-a",
              "text": "还有一个容易忽略的细节：",
              "start": 0.09,
              "end": 1.8
            },
            {
              "id": "06-01-b",
              "text": "如果项目里已经有 CLAUDE.md，",
              "start": 1.8,
              "end": 3.97
            },
            {
              "id": "06-01-c",
              "text": "重新运行 /init 不会粗暴覆盖它",
              "start": 3.97,
              "end": 6.78
            },
            {
              "id": "06-01-d",
              "text": "它会建议哪些地方可以改进，",
              "start": 6.78,
              "end": 8.73
            },
            {
              "id": "06-01-e",
              "text": "原来的文件仍然保留",
              "start": 8.73,
              "end": 10.6
            },
            {
              "id": "06-01-f",
              "text": "你可以把它理解成一次项目说明书检查，",
              "start": 10.6,
              "end": 13.33
            },
            {
              "id": "06-01-g",
              "text": "而不是把旧手册直接扔掉重写",
              "start": 13.33,
              "end": 15.96
            }
          ]
        }
      ]
    },
    {
      "sceneId": "07",
      "file": "subtitles/scene-07.json",
      "segments": [
        {
          "segmentId": "07-01",
          "audioFile": "audio/scene-07/07-01.mp3",
          "cues": [
            {
              "id": "07-01-a",
              "text": "打开生成的 CLAUDE.md，",
              "start": 0.09,
              "end": 2.11
            },
            {
              "id": "07-01-b",
              "text": "通常可以看到几类内容",
              "start": 2.11,
              "end": 3.97
            },
            {
              "id": "07-01-c",
              "text": "项目概述回答这个项目是做什么的，",
              "start": 3.97,
              "end": 6.61
            },
            {
              "id": "07-01-d",
              "text": "技术栈说明用了什么，",
              "start": 6.61,
              "end": 8.03
            },
            {
              "id": "07-01-e",
              "text": "目录结构告诉你关键文件在哪里，",
              "start": 8.03,
              "end": 10.42
            },
            {
              "id": "07-01-f",
              "text": "常用命令说明怎么启动、",
              "start": 10.42,
              "end": 12.24
            },
            {
              "id": "07-01-g",
              "text": "测试和检查，开发规范则记录代码层面的约定",
              "start": 12.24,
              "end": 16.09
            },
            {
              "id": "07-01-h",
              "text": "它们分别对掉以前反复问你的那些问题",
              "start": 16.09,
              "end": 19.08
            }
          ]
        }
      ]
    },
    {
      "sceneId": "08",
      "file": "subtitles/scene-08.json",
      "segments": [
        {
          "segmentId": "08-01",
          "audioFile": "audio/scene-08/08-01.mp3",
          "cues": [
            {
              "id": "08-01-a",
              "text": "文章里还给了一个最小验证",
              "start": 0.09,
              "end": 2.32
            },
            {
              "id": "08-01-b",
              "text": "先建一个叫 init-demo 的目录，",
              "start": 2.32,
              "end": 4.2
            },
            {
              "id": "08-01-c",
              "text": "放入 package.json 和 index",
              "start": 4.2,
              "end": 6.77
            },
            {
              "id": "08-01-d",
              "text": "js。在这个目录启动 Claude Code，",
              "start": 6.77,
              "end": 9.57
            },
            {
              "id": "08-01-e",
              "text": "敲 /init，退出后打开 CLAUDE.md",
              "start": 9.57,
              "end": 12.64
            },
            {
              "id": "08-01-f",
              "text": "如果里面能看到项目名、",
              "start": 12.64,
              "end": 14.24
            },
            {
              "id": "08-01-g",
              "text": "Node.js 或 JavaScript，",
              "start": 14.24,
              "end": 16.31
            },
            {
              "id": "08-01-h",
              "text": "以及 echo test ok 这条测试命令，",
              "start": 16.31,
              "end": 18.81
            },
            {
              "id": "08-01-i",
              "text": "就说明它确实把这个小项目读懂并记下来了",
              "start": 18.81,
              "end": 22.31
            },
            {
              "id": "08-01-j",
              "text": "重新进 Claude，",
              "start": 22.31,
              "end": 23.52
            },
            {
              "id": "08-01-k",
              "text": "再问一次测试命令，",
              "start": 23.52,
              "end": 24.93
            },
            {
              "id": "08-01-l",
              "text": "还可以验证它能直接从说明书里回答",
              "start": 24.93,
              "end": 27.84
            }
          ]
        }
      ]
    },
    {
      "sceneId": "09",
      "file": "subtitles/scene-09.json",
      "segments": [
        {
          "segmentId": "09-01",
          "audioFile": "audio/scene-09/09-01.mp3",
          "cues": [
            {
              "id": "09-01-a",
              "text": "但一定要记住，/init 生成的是草稿，",
              "start": 0.09,
              "end": 2.84
            },
            {
              "id": "09-01-b",
              "text": "不是终稿。分支怎么命名、",
              "start": 2.84,
              "end": 5
            },
            {
              "id": "09-01-c",
              "text": "部署怎么走、Review 有什么要求、",
              "start": 5,
              "end": 7.4
            },
            {
              "id": "09-01-d",
              "text": "某个业务模块为什么不能随便改，",
              "start": 7.4,
              "end": 9.57
            },
            {
              "id": "09-01-e",
              "text": "这些信息可能根本不在代码里",
              "start": 9.57,
              "end": 12.05
            },
            {
              "id": "09-01-f",
              "text": "正确的用法是生成以后通读一遍，",
              "start": 12.05,
              "end": 14.51
            },
            {
              "id": "09-01-g",
              "text": "把它扫不到的硬约束补进去，",
              "start": 14.51,
              "end": 16.31
            },
            {
              "id": "09-01-h",
              "text": "再随着项目变化持续迭代",
              "start": 16.31,
              "end": 18.576
            }
          ]
        }
      ]
    },
    {
      "sceneId": "10",
      "file": "subtitles/scene-10.json",
      "segments": [
        {
          "segmentId": "10-01",
          "audioFile": "audio/scene-10/10-01.mp3",
          "cues": [
            {
              "id": "10-01-a",
              "text": "所以这一篇只要记住一条路径：",
              "start": 0.09,
              "end": 2.37
            },
            {
              "id": "10-01-b",
              "text": "进项目根目录，启动 claude，",
              "start": 2.37,
              "end": 4.32
            },
            {
              "id": "10-01-c",
              "text": "输入 /init，检查生成的 CLAUDE.md，",
              "start": 4.32,
              "end": 7.15
            },
            {
              "id": "10-01-d",
              "text": "再人工补充和维护",
              "start": 7.15,
              "end": 8.92
            },
            {
              "id": "10-01-e",
              "text": "它负责把客观事实快速打底，",
              "start": 8.92,
              "end": 11.22
            },
            {
              "id": "10-01-f",
              "text": "你负责把团队约定和业务背景补完整",
              "start": 11.22,
              "end": 14.12
            },
            {
              "id": "10-01-g",
              "text": "下一篇，我们继续看项目结构里那些 Claude Code 专属",
              "start": 14.12,
              "end": 17.51
            },
            {
              "id": "10-01-h",
              "text": "文件各自负责什么",
              "start": 17.51,
              "end": 19.32
            }
          ]
        }
      ]
    }
  ]
}
