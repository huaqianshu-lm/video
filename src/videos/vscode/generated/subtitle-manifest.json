{
  "schemaVersion": "1.0",
  "videoId": "vscode",
  "scenes": [
    {
      "sceneId": "01",
      "file": "subtitles/scene-01.json",
      "segments": [
        {
          "segmentId": "01-01",
          "audioFile": "audio/scene-01/01-01.mp3",
          "cues": [
            {
              "id": "01-01-a",
              "text": "刚转到 VS Code 扩展时，",
              "start": 0.09,
              "end": 2.13
            },
            {
              "id": "01-01-b",
              "text": "最容易卡住的地方，",
              "start": 2.13,
              "end": 3.37
            },
            {
              "id": "01-01-c",
              "text": "可能不是安装，而是装完以后找不到入口。",
              "start": 3.37,
              "end": 6.63
            },
            {
              "id": "01-01-d",
              "text": "你打开了一个空文件夹，",
              "start": 6.63,
              "end": 8.11
            },
            {
              "id": "01-01-e",
              "text": "左翻右看，编辑器右上角就是没有 Spark 图标。",
              "start": 8.11,
              "end": 11.74
            },
            {
              "id": "01-01-f",
              "text": "先别急着卸载重装。",
              "start": 11.74,
              "end": 13.56
            },
            {
              "id": "01-01-g",
              "text": "这个入口只在你打开具体文件时才会出现，",
              "start": 13.56,
              "end": 16.67
            },
            {
              "id": "01-01-h",
              "text": "光开文件夹是不够的。",
              "start": 16.67,
              "end": 18.48
            },
            {
              "id": "01-01-i",
              "text": "打开 demo.py，",
              "start": 18.48,
              "end": 19.81
            },
            {
              "id": "01-01-j",
              "text": "再回来看右上角，",
              "start": 19.81,
              "end": 21.03
            },
            {
              "id": "01-01-k",
              "text": "入口就出来了。",
              "start": 21.03,
              "end": 22.368
            }
          ]
        }
      ]
    },
    {
      "sceneId": "02",
      "file": "subtitles/scene-02.json",
      "segments": [
        {
          "segmentId": "02-01",
          "audioFile": "audio/scene-02/02-01.mp3",
          "cues": [
            {
              "id": "02-01-a",
              "text": "那扩展和终端里的 Claude Code 到底是什么关系？",
              "start": 0.09,
              "end": 3.53
            },
            {
              "id": "02-01-b",
              "text": "答案是：扩展不是替代 CLI，",
              "start": 3.53,
              "end": 6.03
            },
            {
              "id": "02-01-c",
              "text": "而是在它外面套了一层图形界面。",
              "start": 6.03,
              "end": 8.68
            },
            {
              "id": "02-01-d",
              "text": "可以把它们想成同一个后厨的两个点单窗口。",
              "start": 8.68,
              "end": 11.81
            },
            {
              "id": "02-01-e",
              "text": "两边共享同一份设置，",
              "start": 11.81,
              "end": 13.53
            },
            {
              "id": "02-01-f",
              "text": "对话也可以主动恢复；",
              "start": 13.53,
              "end": 15.24
            },
            {
              "id": "02-01-g",
              "text": "只是扩展和终端不是实时同步的。",
              "start": 15.24,
              "end": 17.95
            },
            {
              "id": "02-01-h",
              "text": "CLI 的命令、skills 和 MCP 配置更完整，",
              "start": 17.95,
              "end": 21.31
            },
            {
              "id": "02-01-i",
              "text": "扩展则把并排 diff 和选中代码上下文做成了原生",
              "start": 21.31,
              "end": 24.92
            },
            {
              "id": "02-01-j",
              "text": "体验。所以它们不是二选一。",
              "start": 24.92,
              "end": 27.768
            }
          ]
        }
      ]
    },
    {
      "sceneId": "03",
      "file": "subtitles/scene-03.json",
      "segments": [
        {
          "segmentId": "03-01",
          "audioFile": "audio/scene-03/03-01.mp3",
          "cues": [
            {
              "id": "03-01-a",
              "text": "安装前先确认 VS Code 是 1.98.0 或更高。",
              "start": 0.09,
              "end": 4.05
            },
            {
              "id": "03-01-b",
              "text": "打开扩展视图，",
              "start": 4.05,
              "end": 5.29
            },
            {
              "id": "03-01-c",
              "text": "搜索 Claude Code 时，",
              "start": 5.29,
              "end": 6.67
            },
            {
              "id": "03-01-d",
              "text": "认准发布者是 Anthropic 的官方扩展。",
              "start": 6.67,
              "end": 9.48
            },
            {
              "id": "03-01-e",
              "text": "也可以用直装链接，",
              "start": 9.48,
              "end": 10.92
            },
            {
              "id": "03-01-f",
              "text": "或者在 Cursor 等编辑器分支的扩展视图里安装。",
              "start": 10.92,
              "end": 14.45
            },
            {
              "id": "03-01-g",
              "text": "装好以后，如果右上角没有图标，",
              "start": 14.45,
              "end": 16.87
            },
            {
              "id": "03-01-h",
              "text": "按这个顺序查：先打开具体文件，",
              "start": 16.87,
              "end": 19.25
            },
            {
              "id": "03-01-i",
              "text": "再确认版本，运行 Developer: ",
              "start": 19.25,
              "end": 21.48
            },
            {
              "id": "03-01-j",
              "text": "Reload Window 重载窗口，",
              "start": 21.48,
              "end": 23.15
            },
            {
              "id": "03-01-k",
              "text": "临时禁用可能冲突的其他 AI 扩展，",
              "start": 23.15,
              "end": 25.68
            },
            {
              "id": "03-01-l",
              "text": "最后确认工作区不是受限模式。",
              "start": 25.68,
              "end": 28.38
            },
            {
              "id": "03-01-m",
              "text": "右上角仍然没有，",
              "start": 28.38,
              "end": 29.72
            },
            {
              "id": "03-01-n",
              "text": "也可以从活动栏、右下角的 Claude Code 状态栏入口，",
              "start": 29.72,
              "end": 33.25
            },
            {
              "id": "03-01-o",
              "text": "或者命令面板打开。",
              "start": 33.25,
              "end": 34.94
            },
            {
              "id": "03-01-p",
              "text": "第一次进入面板，",
              "start": 34.94,
              "end": 36.17
            },
            {
              "id": "03-01-q",
              "text": "还要登录并完成浏览器授权。",
              "start": 36.17,
              "end": 38.664
            }
          ]
        }
      ]
    },
    {
      "sceneId": "04",
      "file": "subtitles/scene-04.json",
      "segments": [
        {
          "segmentId": "04-01",
          "audioFile": "audio/scene-04/04-01.mp3",
          "cues": [
            {
              "id": "04-01-a",
              "text": "扩展最早让人觉得顺手的地方，",
              "start": 0.09,
              "end": 2.3
            },
            {
              "id": "04-01-b",
              "text": "是它把改动放进了 VS Code 原生的 diff 视图。",
              "start": 2.3,
              "end": 5.7
            },
            {
              "id": "04-01-c",
              "text": "左边是原稿，右边是建议改动，",
              "start": 5.7,
              "end": 8.09
            },
            {
              "id": "04-01-d",
              "text": "新增和删除用颜色直接标出来。",
              "start": 8.09,
              "end": 10.64
            },
            {
              "id": "04-01-e",
              "text": "你可以接受，也可以拒绝。",
              "start": 10.64,
              "end": 12.76
            },
            {
              "id": "04-01-f",
              "text": "更重要的是，接受之前还能直接在右侧把建议",
              "start": 12.76,
              "end": 16.17
            },
            {
              "id": "04-01-g",
              "text": "改对。比如让它把 greet 改成 f-string、",
              "start": 16.17,
              "end": 19.18
            },
            {
              "id": "04-01-h",
              "text": "加上类型注解，",
              "start": 19.18,
              "end": 20.42
            },
            {
              "id": "04-01-i",
              "text": "先看清楚每一处，",
              "start": 20.42,
              "end": 21.66
            },
            {
              "id": "04-01-j",
              "text": "再点接受。这个流程不是让 AI 替你签字，",
              "start": 21.66,
              "end": 25.16
            },
            {
              "id": "04-01-k",
              "text": "而是让它把修改摆到你面前。",
              "start": 25.16,
              "end": 27.432
            }
          ]
        }
      ]
    },
    {
      "sceneId": "05",
      "file": "subtitles/scene-05.json",
      "segments": [
        {
          "segmentId": "05-01",
          "audioFile": "audio/scene-05/05-01.mp3",
          "cues": [
            {
              "id": "05-01-a",
              "text": "让 Claude 干活时，",
              "start": 0.09,
              "end": 1.38
            },
            {
              "id": "05-01-b",
              "text": "最大的浪费之一，",
              "start": 1.38,
              "end": 2.6
            },
            {
              "id": "05-01-c",
              "text": "是它不知道你说的是哪份文件、",
              "start": 2.6,
              "end": 4.69
            },
            {
              "id": "05-01-d",
              "text": "哪段代码。扩展里有两个快捷办法。",
              "start": 4.69,
              "end": 7.94
            },
            {
              "id": "05-01-e",
              "text": "输入 @，可以模糊匹配文件或文件夹，",
              "start": 7.94,
              "end": 10.86
            },
            {
              "id": "05-01-f",
              "text": "比如 @auth，或者 @src/components/。",
              "start": 10.86,
              "end": 14.25
            },
            {
              "id": "05-01-g",
              "text": "另一招更直接：",
              "start": 14.25,
              "end": 15.46
            },
            {
              "id": "05-01-h",
              "text": "在编辑器里选中代码，",
              "start": 15.46,
              "end": 17.07
            },
            {
              "id": "05-01-i",
              "text": "它就能自动看到这段内容。",
              "start": 17.07,
              "end": 19.05
            },
            {
              "id": "05-01-j",
              "text": "你可以问“这段为什么报错”，",
              "start": 19.05,
              "end": 20.72
            },
            {
              "id": "05-01-k",
              "text": "不用再花半天描述位置。",
              "start": 20.72,
              "end": 22.66
            },
            {
              "id": "05-01-l",
              "text": "编辑器获得焦点时，",
              "start": 22.66,
              "end": 24.2
            },
            {
              "id": "05-01-m",
              "text": "还能用 Option 加 K，",
              "start": 24.2,
              "end": 25.59
            },
            {
              "id": "05-01-n",
              "text": "或者 Alt 加 K，",
              "start": 25.59,
              "end": 26.85
            },
            {
              "id": "05-01-o",
              "text": "插入带路径和行号的引用。",
              "start": 26.85,
              "end": 29.088
            }
          ]
        }
      ]
    },
    {
      "sceneId": "06",
      "file": "subtitles/scene-06.json",
      "segments": [
        {
          "segmentId": "06-01",
          "audioFile": "audio/scene-06/06-01.mp3",
          "cues": [
            {
              "id": "06-01-a",
              "text": "小改动可以直接处理，",
              "start": 0.09,
              "end": 1.78
            },
            {
              "id": "06-01-b",
              "text": "但多文件或较大的改动，",
              "start": 1.78,
              "end": 3.55
            },
            {
              "id": "06-01-c",
              "text": "最好先看方案。",
              "start": 3.55,
              "end": 4.95
            },
            {
              "id": "06-01-d",
              "text": "正常模式是每一步都问你，",
              "start": 4.95,
              "end": 6.92
            },
            {
              "id": "06-01-e",
              "text": "自动接受模式则直接执行，",
              "start": 6.92,
              "end": 8.99
            },
            {
              "id": "06-01-f",
              "text": "而 Plan Mode 会先把计划作为 Markdown 文档打开。",
              "start": 8.99,
              "end": 12.45
            },
            {
              "id": "06-01-g",
              "text": "比如要给 demo.py 增加命令行参数支持，",
              "start": 12.45,
              "end": 15.91
            },
            {
              "id": "06-01-h",
              "text": "先让它列出准备怎么做。",
              "start": 15.91,
              "end": 17.93
            },
            {
              "id": "06-01-i",
              "text": "你可以在第二步旁边加一条内联批注，",
              "start": 17.93,
              "end": 20.52
            },
            {
              "id": "06-01-j",
              "text": "让它先确认参数入口。",
              "start": 20.52,
              "end": 22.43
            },
            {
              "id": "06-01-k",
              "text": "等方向确认以后，",
              "start": 22.43,
              "end": 23.69
            },
            {
              "id": "06-01-l",
              "text": "再批准执行。",
              "start": 23.69,
              "end": 25.03
            },
            {
              "id": "06-01-m",
              "text": "先审计划，通常比改完一堆文件再返工省事。",
              "start": 25.03,
              "end": 28.896
            }
          ]
        }
      ]
    },
    {
      "sceneId": "07",
      "file": "subtitles/scene-07.json",
      "segments": [
        {
          "segmentId": "07-01",
          "audioFile": "audio/scene-07/07-01.mp3",
          "cues": [
            {
              "id": "07-01-a",
              "text": "现在把这三个核心能力串起来。",
              "start": 0.09,
              "end": 2.45
            },
            {
              "id": "07-01-b",
              "text": "先创建一个 vscode-claude-demo 文件夹，",
              "start": 2.45,
              "end": 5.04
            },
            {
              "id": "07-01-c",
              "text": "放入 demo.py，",
              "start": 5.04,
              "end": 6.33
            },
            {
              "id": "07-01-d",
              "text": "再用 code . 打开。",
              "start": 6.33,
              "end": 8.33
            },
            {
              "id": "07-01-e",
              "text": "打开文件，进入 Claude 面板并登录。",
              "start": 8.33,
              "end": 11.19
            },
            {
              "id": "07-01-f",
              "text": "选中 greet 函数，",
              "start": 11.19,
              "end": 12.46
            },
            {
              "id": "07-01-g",
              "text": "让它改成 f-string 并加上类型注解。",
              "start": 12.46,
              "end": 15.46
            },
            {
              "id": "07-01-h",
              "text": "改动出现后，在并排 diff 里看清楚，",
              "start": 15.46,
              "end": 18.06
            },
            {
              "id": "07-01-i",
              "text": "再决定接受。",
              "start": 18.06,
              "end": 19.35
            },
            {
              "id": "07-01-j",
              "text": "接着切到 Plan Mode，",
              "start": 19.35,
              "end": 20.77
            },
            {
              "id": "07-01-k",
              "text": "让它为这个文件增加命令行参数支持。",
              "start": 20.77,
              "end": 23.79
            },
            {
              "id": "07-01-l",
              "text": "跑完这条路径，你就把入口、",
              "start": 23.79,
              "end": 25.79
            },
            {
              "id": "07-01-m",
              "text": "上下文、diff 和计划审阅都用了一遍。",
              "start": 25.79,
              "end": 28.968
            }
          ]
        }
      ]
    },
    {
      "sceneId": "08",
      "file": "subtitles/scene-08.json",
      "segments": [
        {
          "segmentId": "08-01",
          "audioFile": "audio/scene-08/08-01.mp3",
          "cues": [
            {
              "id": "08-01-a",
              "text": "日常用起来，记住几组快捷键就够了。",
              "start": 0.09,
              "end": 3.09
            },
            {
              "id": "08-01-b",
              "text": "Cmd 加 Esc，",
              "start": 3.09,
              "end": 4.67
            },
            {
              "id": "08-01-c",
              "text": "或者 Ctrl 加 Esc，",
              "start": 4.67,
              "end": 6.42
            },
            {
              "id": "08-01-d",
              "text": "用来在编辑器和 Claude 之间切换焦点。",
              "start": 6.42,
              "end": 9.35
            },
            {
              "id": "08-01-e",
              "text": "Cmd 加 Shift 加 Esc，",
              "start": 9.35,
              "end": 11.5
            },
            {
              "id": "08-01-f",
              "text": "可以在新选项卡打开对话。",
              "start": 11.5,
              "end": 13.68
            },
            {
              "id": "08-01-g",
              "text": "Option 加 K，或者 Alt 加 K，",
              "start": 13.68,
              "end": 15.85
            },
            {
              "id": "08-01-h",
              "text": "插入提及引用。",
              "start": 15.85,
              "end": 17.28
            },
            {
              "id": "08-01-i",
              "text": "Cmd 加 Shift 加 T，",
              "start": 17.28,
              "end": 19.01
            },
            {
              "id": "08-01-j",
              "text": "可以重新打开刚关掉的会话。",
              "start": 19.01,
              "end": 21.2
            },
            {
              "id": "08-01-k",
              "text": "需要终端味的工作时，",
              "start": 21.2,
              "end": 22.69
            },
            {
              "id": "08-01-l",
              "text": "在集成终端运行 claude；",
              "start": 22.69,
              "end": 24.53
            },
            {
              "id": "08-01-m",
              "text": "外部终端也可以用 /ide 手动连接。",
              "start": 24.53,
              "end": 27.38
            },
            {
              "id": "08-01-n",
              "text": "文件和改动审阅用扩展，",
              "start": 27.38,
              "end": 29.34
            },
            {
              "id": "08-01-o",
              "text": "批量命令、完整 skills 和 MCP 配置",
              "start": 29.34,
              "end": 32.22
            },
            {
              "id": "08-01-p",
              "text": "切回 CLI。",
              "start": 32.22,
              "end": 33.576
            }
          ]
        }
      ]
    },
    {
      "sceneId": "09",
      "file": "subtitles/scene-09.json",
      "segments": [
        {
          "segmentId": "09-01",
          "audioFile": "audio/scene-09/09-01.mp3",
          "cues": [
            {
              "id": "09-01-a",
              "text": "所以，VS Code 扩展不是把 CLI 淘汰掉了。",
              "start": 0.09,
              "end": 3.71
            },
            {
              "id": "09-01-b",
              "text": "它更适合在文件旁边提供上下文、",
              "start": 3.71,
              "end": 6.23
            },
            {
              "id": "09-01-c",
              "text": "查看 diff 和审阅计划；",
              "start": 6.23,
              "end": 8.16
            },
            {
              "id": "09-01-d",
              "text": "CLI 则保留完整的命令、",
              "start": 8.16,
              "end": 10.07
            },
            {
              "id": "09-01-e",
              "text": "skills、MCP 配置和终端快捷操作。",
              "start": 10.07,
              "end": 13.4
            },
            {
              "id": "09-01-f",
              "text": "同一个引擎，两扇窗口，",
              "start": 13.4,
              "end": 15.34
            },
            {
              "id": "09-01-g",
              "text": "按手头的任务切换就行。",
              "start": 15.34,
              "end": 17.34
            },
            {
              "id": "09-01-h",
              "text": "下一篇我们继续看 JetBrains 集成，",
              "start": 17.34,
              "end": 19.97
            },
            {
              "id": "09-01-i",
              "text": "看看 IntelliJ IDEA、",
              "start": 19.97,
