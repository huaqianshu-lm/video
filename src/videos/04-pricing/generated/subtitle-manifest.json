{
  "schemaVersion": "1.0",
  "videoId": "04-pricing",
  "scenes": [
    {
      "sceneId": "01",
      "file": "subtitles/scene-01.json",
      "segments": [
        {
          "segmentId": "01-01",
          "audioFile": "audio/scene-01/01-01.mp3",
          "cues": [
            {
              "id": "01-01-a",
              "text": "看起来同样是一条消息，",
              "start": 0.09,
              "end": 1.85
            },
            {
              "id": "01-01-b",
              "text": "实际消耗却可能完全不同。",
              "start": 1.85,
              "end": 4.128
            }
          ]
        },
        {
          "segmentId": "01-02",
          "audioFile": "audio/scene-01/01-02.mp3",
          "cues": [
            {
              "id": "01-02-a",
              "text": "让 AI 帮你改一个几行的小脚本，",
              "start": 0.09,
              "end": 2.48
            },
            {
              "id": "01-02-b",
              "text": "和让它处理一个大型代码库，",
              "start": 2.48,
              "end": 4.29
            },
            {
              "id": "01-02-c",
              "text": "表面上都只是发出一次请求。",
              "start": 4.29,
              "end": 6.72
            },
            {
              "id": "01-02-d",
              "text": "但后者可能还要读取更多文件，",
              "start": 6.72,
              "end": 9.02
            },
            {
              "id": "01-02-e",
              "text": "理解更大的项目，",
              "start": 9.02,
              "end": 10.31
            },
            {
              "id": "01-02-f",
              "text": "带上更长的历史会话，",
              "start": 10.31,
              "end": 11.78
            },
            {
              "id": "01-02-g",
              "text": "以及更多规则。",
              "start": 11.78,
              "end": 13.224
            }
          ]
        },
        {
          "segmentId": "01-03",
          "audioFile": "audio/scene-01/01-03.mp3",
          "cues": [
            {
              "id": "01-03-a",
              "text": "所以，消息条数只能说明你发了几次消息，",
              "start": 0.09,
              "end": 3.36
            },
            {
              "id": "01-03-b",
              "text": "不能单独代表实际用量。",
              "start": 3.36,
              "end": 5.3
            },
            {
              "id": "01-03-c",
              "text": "真正影响消耗的，",
              "start": 5.3,
              "end": 6.61
            },
            {
              "id": "01-03-d",
              "text": "是每次任务需要处理多少内容，",
              "start": 6.61,
              "end": 8.85
            },
            {
              "id": "01-03-e",
              "text": "以及要完成多少工作。",
              "start": 8.85,
              "end": 10.584
            }
          ]
        }
      ]
    },
    {
      "sceneId": "02",
      "file": "subtitles/scene-02.json",
      "segments": [
        {
          "segmentId": "02-01",
          "audioFile": "audio/scene-02/02-01.mp3",
          "cues": [
            {
              "id": "02-01-a",
              "text": "要理解后面的计费，",
              "start": 0.09,
              "end": 1.54
            },
            {
              "id": "02-01-b",
              "text": "先把三个层次分开。",
              "start": 1.54,
              "end": 3.24
            }
          ]
        },
        {
          "segmentId": "02-02",
          "audioFile": "audio/scene-02/02-02.mp3",
          "cues": [
            {
              "id": "02-02-a",
              "text": "Codex 是使用模型能力的工具入口，",
              "start": 0.09,
              "end": 2.67
            },
            {
              "id": "02-02-b",
              "text": "模型负责处理你的任务，",
              "start": 2.67,
              "end": 4.21
            },
            {
              "id": "02-02-c",
              "text": "而输入 token、输出 token，",
              "start": 4.21,
              "end": 6.18
            },
            {
              "id": "02-02-d",
              "text": "以及每一轮携带的上下文，",
              "start": 6.18,
              "end": 8.05
            },
            {
              "id": "02-02-e",
              "text": "是观察处理量的基本计量单位。",
              "start": 8.05,
              "end": 10.44
            }
          ]
        },
        {
          "segmentId": "02-03",
          "audioFile": "audio/scene-02/02-03.mp3",
          "cues": [
            {
              "id": "02-03-a",
              "text": "输入 token 包括你给出的指令和需要读取的内容，",
              "start": 0.09,
              "end": 3.53
            },
            {
              "id": "02-03-b",
              "text": "输出 token 是模型生成的结果，",
              "start": 3.53,
              "end": 5.75
            },
            {
              "id": "02-03-c",
              "text": "上下文则可能包含文件、",
              "start": 5.75,
              "end": 7.66
            },
            {
              "id": "02-03-d",
              "text": "历史会话和其他相关信息。",
              "start": 7.66,
              "end": 10.008
            }
          ]
        },
        {
          "segmentId": "02-04",
          "audioFile": "audio/scene-02/02-04.mp3",
          "cues": [
            {
              "id": "02-04-a",
              "text": "Token 不是固定的字符数，",
              "start": 0.09,
              "end": 1.98
            },
            {
              "id": "02-04-b",
              "text": "也不等于固定的消息数。",
              "start": 1.98,
              "end": 3.83
            },
            {
              "id": "02-04-c",
              "text": "相同的一句话，放在不同的任务和上下文里，",
              "start": 3.83,
              "end": 7.04
            },
            {
              "id": "02-04-d",
              "text": "带来的实际处理量可能不同。",
              "start": 7.04,
              "end": 9.36
            }
          ]
        }
      ]
    },
    {
      "sceneId": "03",
      "file": "subtitles/scene-03.json",
      "segments": [
        {
          "segmentId": "03-01",
          "audioFile": "audio/scene-03/03-01.mp3",
          "cues": [
            {
              "id": "03-01-a",
              "text": "如果你登录 ChatGPT 账号，",
              "start": 0.09,
              "end": 2.11
            },
            {
              "id": "03-01-b",
              "text": "首先面对的是订阅这条账。",
              "start": 2.11,
              "end": 4.44
            }
          ]
        },
        {
          "segmentId": "03-02",
          "audioFile": "audio/scene-03/03-02.mp3",
          "cues": [
            {
              "id": "03-02-a",
              "text": "你支付固定的月费，",
              "start": 0.09,
              "end": 1.5
            },
            {
              "id": "03-02-b",
              "text": "按照当前订阅规则获得相应的使用额度和能力。",
              "start": 1.5,
              "end": 5.16
            },
            {
              "id": "03-02-c",
              "text": "这里的可用量通常不是每天固定清零，",
              "start": 5.16,
              "end": 7.92
            },
            {
              "id": "03-02-d",
              "text": "而是受到滚动限额和当前使用情况影响。",
              "start": 7.92,
              "end": 11.16
            }
          ]
        },
        {
          "segmentId": "03-03",
          "audioFile": "audio/scene-03/03-03.mp3",
          "cues": [
            {
              "id": "03-03-a",
              "text": "当订阅用量达到限额时，",
              "start": 0.09,
              "end": 1.95
            },
            {
              "id": "03-03-b",
              "text": "部分情况下可以购买积分，",
              "start": 1.95,
              "end": 3.91
            },
            {
              "id": "03-03-c",
              "text": "继续获得额外的使用通道。",
              "start": 3.91,
              "end": 5.93
            },
            {
              "id": "03-03-d",
              "text": "但积分解决的是订阅路径下的继续使用问题，",
              "start": 5.93,
              "end": 9.02
            },
            {
              "id": "03-03-e",
              "text": "它不会把 ChatGPT 订阅和 API 账单",
              "start": 9.02,
              "end": 11.75
            },
            {
              "id": "03-03-f",
              "text": "合并成一套账。",
              "start": 11.75,
              "end": 13.224
            }
          ]
        }
      ]
    },
    {
      "sceneId": "04",
      "file": "subtitles/scene-04.json",
      "segments": [
        {
          "segmentId": "04-01",
          "audioFile": "audio/scene-04/04-01.mp3",
          "cues": [
            {
              "id": "04-01-a",
              "text": "另一条路径是 API key。",
              "start": 0.09,
              "end": 2.28
            }
          ]
        },
        {
          "segmentId": "04-02",
          "audioFile": "audio/scene-04/04-02.mp3",
          "cues": [
            {
              "id": "04-02-a",
              "text": "它主要面向脚本、",
              "start": 0.09,
              "end": 1.34
            },
            {
              "id": "04-02-b",
              "text": "CI/CD 和其他程序化任务。",
              "start": 1.34,
              "end": 3.82
            },
            {
              "id": "04-02-c",
              "text": "程序通过 API key 调用模型，",
              "start": 3.82,
              "end": 6.15
            },
            {
              "id": "04-02-d",
              "text": "按照实际的输入 token 和输出 token 用量计费，",
              "start": 6.15,
              "end": 9.3
            },
            {
              "id": "04-02-e",
              "text": "账单在 OpenAI Platform 中单独计算。",
              "start": 9.3,
              "end": 12.456
            }
          ]
        },
        {
          "segmentId": "04-03",
          "audioFile": "audio/scene-04/04-03.mp3",
          "cues": [
            {
              "id": "04-03-a",
              "text": "这就形成了两套账：",
              "start": 0.09,
              "end": 1.51
            },
            {
              "id": "04-03-b",
              "text": "一套是 ChatGPT 账号对应的订阅和积分，",
              "start": 1.51,
              "end": 4.64
            },
            {
              "id": "04-03-c",
              "text": "另一套是 API key 对应的 Platform 账单。",
              "start": 4.64,
              "end": 7.872
            }
          ]
        },
        {
          "segmentId": "04-04",
          "audioFile": "audio/scene-04/04-04.mp3",
          "cues": [
            {
              "id": "04-04-a",
              "text": "ChatGPT 的月费不是 API 余额，",
              "start": 0.09,
              "end": 2.74
            },
            {
              "id": "04-04-b",
              "text": "ChatGPT 积分也不是 API key 的预充值。",
              "start": 2.74,
              "end": 6.13
            },
            {
              "id": "04-04-c",
              "text": "判断费用之前，",
              "start": 6.13,
              "end": 7.35
            },
            {
              "id": "04-04-d",
              "text": "先确认自己走的是哪条使用路径。",
              "start": 7.35,
              "end": 10.248
            }
          ]
        }
      ]
    },
    {
      "sceneId": "05",
      "file": "subtitles/scene-05.json",
      "segments": [
        {
          "segmentId": "05-01",
          "audioFile": "audio/scene-05/05-01.mp3",
          "cues": [
            {
              "id": "05-01-a",
              "text": "确认付费路径之后，",
              "start": 0.09,
              "end": 1.57
            },
            {
              "id": "05-01-b",
              "text": "套餐不要先从金额或某个数字开始比较，",
              "start": 1.57,
              "end": 4.65
            },
            {
              "id": "05-01-c",
              "text": "而要先看自己的使用场景。",
              "start": 4.65,
              "end": 6.696
            }
          ]
        },
        {
          "segmentId": "05-02",
          "audioFile": "audio/scene-05/05-02.mp3",
          "cues": [
            {
              "id": "05-02-a",
              "text": "个人开发者通常先关注日常开发是否够用；",
              "start": 0.09,
              "end": 3.36
            },
            {
              "id": "05-02-b",
              "text": "如果是高频、重度的个人使用，",
              "start": 3.36,
              "end": 5.5
            },
            {
              "id": "05-02-c",
              "text": "就要进一步关注使用强度和额度空间。",
              "start": 5.5,
              "end": 8.4
            }
          ]
        },
        {
          "segmentId": "05-03",
          "audioFile": "audio/scene-05/05-03.mp3",
          "cues": [
            {
              "id": "05-03-a",
              "text": "团队协作时，重点会转向成员管理、",
              "start": 0.09,
              "end": 2.93
            },
            {
              "id": "05-03-b",
              "text": "共享工作方式和组织协作。",
              "start": 2.93,
              "end": 5.3
            },
            {
              "id": "05-03-c",
              "text": "到了组织级部署，",
              "start": 5.3,
              "end": 6.5
            },
            {
              "id": "05-03-d",
              "text": "还要关注管理、安全和合规需求。",
              "start": 6.5,
              "end": 9.456
            }
          ]
        },
        {
          "segmentId": "05-04",
          "audioFile": "audio/scene-05/05-04.mp3",
          "cues": [
            {
              "id": "05-04-a",
              "text": "因此，Plus、",
              "start": 0.09,
              "end": 1.34
            },
            {
              "id": "05-04-b",
              "text": "Pro、Business、",
              "start": 1.34,
              "end": 2.57
            },
            {
              "id": "05-04-c",
              "text": "Enterprise and Edu 可以先理解成从个人到重度个人、",
              "start": 2.57,
              "end": 5.98
            },
            {
              "id": "05-04-d",
              "text": "团队，再到组织级部署的不同层次。",
              "start": 5.98,
              "end": 8.78
            },
            {
              "id": "05-04-e",
              "text": "具体金额、消息区间、",
              "start": 8.78,
              "end": 10.58
            },
            {
              "id": "05-04-f",
              "text": "模型名称和支持范围可能变化，",
              "start": 10.58,
              "end": 13.02
            },
            {
              "id": "05-04-g",
              "text": "购买前要以当前页面为准；",
              "start": 13.02,
              "end": 15.01
            },
            {
              "id": "05-04-h",
              "text": "Free 或 Go 是否适用，",
              "start": 15.01,
              "end": 16.59
            },
            {
              "id": "05-04-i",
              "text": "也应单独核对当前支持范围。",
              "start": 16.59,
              "end": 19.008
            }
          ]
        }
      ]
    },
    {
      "sceneId": "06",
      "file": "subtitles/scene-06.json",
      "segments": [
        {
          "segmentId": "06-01",
          "audioFile": "audio/scene-06/06-01.mp3",
          "cues": [
            {
              "id": "06-01-a",
              "text": "限额更适合被理解成一个时间窗口里的动态资源，",
              "start": 0.09,
              "end": 3.86
            },
            {
              "id": "06-01-b",
              "text": "而不是每天固定清零的计数器。",
              "start": 3.86,
              "end": 6.288
            }
          ]
        },
        {
          "segmentId": "06-02",
          "audioFile": "audio/scene-06/06-02.mp3",
          "cues": [
            {
              "id": "06-02-a",
              "text": "以五小时滚动窗口为例，",
              "start": 0.09,
              "end": 1.84
            },
            {
              "id": "06-02-b",
              "text": "窗口会随着时间向前移动。",
              "start": 1.84,
              "end": 4.05
            },
            {
              "id": "06-02-c",
              "text": "一个小脚本可能只占用较小的处理量，",
              "start": 4.05,
              "end": 6.77
            },
            {
              "id": "06-02-d",
              "text": "而大型代码库、长会话、",
              "start": 6.77,
              "end": 8.77
            },
            {
              "id": "06-02-e",
              "text": "复杂任务，或者不同模型，",
              "start": 8.77,
              "end": 10.82
            },
            {
              "id": "06-02-f",
              "text": "都可能让同一条消息消耗得更快。",
              "start": 10.82,
              "end": 13.512
            }
          ]
        },
        {
          "segmentId": "06-03",
          "audioFile": "audio/scene-06/06-03.mp3",
          "cues": [
            {
              "id": "06-03-a",
              "text": "当窗口内的可用量触顶时，",
              "start": 0.09,
              "end": 2.06
            },
            {
              "id": "06-03-b",
              "text": "订阅路径下的积分可能提供额外使用通道。",
              "start": 2.06,
              "end": 5.34
            },
            {
              "id": "06-03-c",
              "text": "但它不会让上下文自动变小，",
              "start": 5.34,
              "end": 7.42
            },
            {
              "id": "06-03-d",
              "text": "也不会改变 ChatGPT 订阅和 API ",
              "start": 7.42,
              "end": 10.1
            },
            {
              "id": "06-03-e",
              "text": "账单之间的边界。",
              "start": 10.1,
              "end": 11.616
            }
          ]
        }
      ]
    },
    {
      "sceneId": "07",
      "file": "subtitles/scene-07.json",
      "segments": [
        {
          "segmentId": "07-01",
          "audioFile": "audio/scene-07/07-01.mp3",
          "cues": [
            {
              "id": "07-01-a",
              "text": "当你觉得额度不够时，",
              "start": 0.09,
              "end": 1.54
            },
            {
              "id": "07-01-b",
              "text": "先别急着升级套餐。",
              "start": 1.54,
              "end": 3.25
            },
            {
              "id": "07-01-c",
              "text": "很多时候，更有效的第一步是减少无效上下文。",
              "start": 3.25,
              "end": 7.032
            }
          ]
        },
        {
          "segmentId": "07-02",
          "audioFile": "audio/scene-07/07-02.mp3",
          "cues": [
            {
              "id": "07-02-a",
              "text": "第一，缩小输入范围，",
              "start": 0.09,
              "end": 1.9
            },
            {
              "id": "07-02-b",
              "text": "把模糊的“帮我看看”改成明确的文件、",
              "start": 1.9,
              "end": 4.19
            },
            {
              "id": "07-02-c",
              "text": "函数或问题。",
              "start": 4.19,
              "end": 5.54
            },
            {
              "id": "07-02-d",
              "text": "第二，压缩固定上下文，",
              "start": 5.54,
              "end": 7.46
            },
            {
              "id": "07-02-e",
              "text": "把一大套规则整理成真正需要的部分。",
              "start": 7.46,
              "end": 10.4
            },
            {
              "id": "07-02-f",
              "text": "第三，按需连接工具，",
              "start": 10.4,
              "end": 12.19
            },
            {
              "id": "07-02-g",
              "text": "不要让每个任务都加载全部能力。",
              "start": 12.19,
              "end": 14.76
            },
            {
              "id": "07-02-h",
              "text": "第四，让模型和任务匹配，",
              "start": 14.76,
              "end": 16.94
            },
            {
              "id": "07-02-i",
              "text": "简单工作不必一直使用最重的模型。",
              "start": 16.94,
              "end": 19.824
            }
          ]
        },
        {
          "segmentId": "07-03",
          "audioFile": "audio/scene-07/07-03.mp3",
          "cues": [
            {
              "id": "07-03-a",
              "text": "切换到无关工作时，",
              "start": 0.09,
              "end": 1.51
            },
            {
              "id": "07-03-b",
              "text": "还可以用 /new 清理旧会话，",
              "start": 1.51,
              "end": 3.23
            },
            {
              "id": "07-03-c",
              "text": "避免前一个任务继续影响当前上下文。",
              "start": 3.23,
              "end": 6.168
            }
          ]
        },
        {
          "segmentId": "07-04",
          "audioFile": "audio/scene-07/07-04.mp3",
          "cues": [
            {
              "id": "07-04-a",
              "text": "成本控制的核心不是把所有东西都关掉，",
              "start": 0.09,
              "end": 3.02
            },
            {
              "id": "07-04-b",
              "text": "而是让上下文变得短而准。",
              "start": 3.02,
              "end": 5.112
            }
          ]
        }
      ]
    },
    {
      "sceneId": "08",
      "file": "subtitles/scene-08.json",
      "segments": [
        {
          "segmentId": "08-01",
          "audioFile": "audio/scene-08/08-01.mp3",
          "cues": [
            {
              "id": "08-01-a",
              "text": "可以把用量管理变成一个固定的四步习惯：",
              "start": 0.09,
              "end": 2.9
            },
            {
              "id": "08-01-b",
              "text": "查看、调整、清理、复盘。",
              "start": 2.9,
              "end": 5.592
            }
          ]
        },
        {
          "segmentId": "08-02",
          "audioFile": "audio/scene-08/08-02.mp3",
          "cues": [
            {
              "id": "08-02-a",
              "text": "开始任务前，用 /status 查看当前状态、",
              "start": 0.09,
              "end": 3.21
            },
            {
              "id": "08-02-b",
              "text": "审批策略和上下文容量；",
              "start": 3.21,
              "end": 5.08
            },
            {
              "id": "08-02-c",
              "text": "用 /model 确认当前模型是否适合这项工作。",
              "start": 5.08,
              "end": 8.52
            },
            {
              "id": "08-02-d",
              "text": "需要切换到另一件事时，",
              "start": 8.52,
              "end": 10.16
            },
            {
              "id": "08-02-e",
              "text": "用 /new 清理无关会话。",
              "start": 10.16,
              "end": 11.976
            }
          ]
        },
        {
          "segmentId": "08-03",
          "audioFile": "audio/scene-08/08-03.mp3",
          "cues": [
            {
              "id": "08-03-a",
              "text": "任务完成后再复盘用量：",
              "start": 0.09,
              "end": 2.08
            },
            {
              "id": "08-03-b",
              "text": "ChatGPT 用户查看订阅用量面板，",
              "start": 2.08,
              "end": 4.68
            },
            {
              "id": "08-03-c",
              "text": "API 用户查看 API Platform 账单。",
              "start": 4.68,
              "end": 7.75
            },
            {
              "id": "08-03-d",
              "text": "这样，你看到的是各自路径下的真实使用情况，",
              "start": 7.75,
              "end": 11.1
            },
            {
              "id": "08-03-e",
              "text": "而不是把两套账混成一个总数。",
              "start": 11.1,
              "end": 13.632
            }
          ]
        }
      ]
    },
    {
      "sceneId": "09",
      "file": "subtitles/scene-09.json",
      "segments": [
        {
          "segmentId": "09-01",
          "audioFile": "audio/scene-09/09-01.mp3",
          "cues": [
            {
              "id": "09-01-a",
              "text": "最后，可以用四个问题判断自己的下一步：",
              "start": 0.09,
              "end": 3.1
            },
            {
              "id": "09-01-b",
              "text": "我登录的是哪条路径？",
              "start": 3.1,
              "end": 4.78
            },
            {
              "id": "09-01-c",
              "text": "当前任务是手动使用还是程序化调用？",
              "start": 4.78,
              "end": 8.0
            },
            {
              "id": "09-01-d",
              "text": "任务需要多大的上下文？",
              "start": 8.0,
              "end": 9.87
            },
            {
              "id": "09-01-e",
              "text": "我应该在哪里观察用量？",
              "start": 9.87,
              "end": 11.808
            }
          ]
        },
        {
          "segmentId": "09-02",
          "audioFile": "audio/scene-09/09-02.mp3",
          "cues": [
            {
              "id": "09-02-a",
              "text": "先确认是订阅额度还是 API 按量计费，",
              "start": 0.09,
              "end": 3.28
            },
            {
              "id": "09-02-b",
              "text": "再结合任务类型和上下文规模，",
              "start": 3.28,
              "end": 5.67
            },
            {
              "id": "09-02-c",
              "text": "决定是否需要调整套餐或工作方式。",
              "start": 5.67,
              "end": 8.65
            },
            {
              "id": "09-02-d",
              "text": "很多额度问题，",
              "start": 8.65,
              "end": 9.93
            },
            {
              "id": "09-02-e",
              "text": "先通过减少无效上下文就能得到改善。",
              "start": 9.93,
              "end": 13.008
            }
          ]
        },
        {
          "segmentId": "09-03",
          "audioFile": "audio/scene-09/09-03.mp3",
          "cues": [
            {
              "id": "09-03-a",
              "text": "下一集，我们继续看如何接入 DeepSeek 等国产模型，",
              "start": 0.09,
              "end": 3.9
            },
            {
              "id": "09-03-b",
              "text": "以及不同模型接入方式之间有什么区别。",
              "start": 3.9,
              "end": 6.984
            }
          ]
        }
      ]
    }
  ]
