{
  "schemaVersion": "1.0",
  "videoId": "claude-code-coding-plan",
  "scenes": [
    {
      "sceneId": "01",
      "file": "subtitles/scene-01.json",
      "segments": [
        {
          "segmentId": "01-01",
          "audioFile": "audio/scene-01/01-01.mp3",
          "cues": [
            {
              "id": "01-01-a",
              "text": "官方文档里有一个数字",
              "start": 0.09,
              "end": 1.73
            },
            {
              "id": "01-01-b",
              "text": "很多人第一次看到都会愣一下",
              "start": 1.73,
              "end": 3.92
            },
            {
              "id": "01-01-c",
              "text": "企业部署中，每个开发者平均每天可能消耗十几美元",
              "start": 3.92,
              "end": 7.76
            },
            {
              "id": "01-01-d",
              "text": "一个月甚至达到一两百美元",
              "start": 7.76,
              "end": 10.152
            }
          ]
        },
        {
          "segmentId": "01-02",
          "audioFile": "audio/scene-01/01-02.mp3",
          "cues": [
            {
              "id": "01-02-a",
              "text": "这不是说你用 Claude Code 就一定会花这么多钱",
              "start": 0.09,
              "end": 3.31
            },
            {
              "id": "01-02-b",
              "text": "真正值得警惕的是",
              "start": 3.31,
              "end": 4.73
            },
            {
              "id": "01-02-c",
              "text": "很多人用了一周",
              "start": 4.73,
              "end": 5.97
            },
            {
              "id": "01-02-d",
              "text": "打开账单时却完全说不清钱到底花在了哪里",
              "start": 5.97,
              "end": 9.672
            }
          ]
        },
        {
          "segmentId": "01-03",
          "audioFile": "audio/scene-01/01-03.mp3",
          "cues": [
            {
              "id": "01-03-a",
              "text": "是模型选贵了",
              "start": 0.09,
              "end": 1.59
            },
            {
              "id": "01-03-b",
              "text": "是对话太长了",
              "start": 1.59,
              "end": 3.07
            },
            {
              "id": "01-03-c",
              "text": "还是有一次让它读了太多文件",
              "start": 3.07,
              "end": 5.544
            }
          ]
        },
        {
          "segmentId": "01-04",
          "audioFile": "audio/scene-01/01-04.mp3",
          "cues": [
            {
              "id": "01-04-a",
              "text": "所以这一篇，我们先不急着讨论哪个套餐便宜",
              "start": 0.09,
              "end": 3.62
            },
            {
              "id": "01-04-b",
              "text": "先把账算明白：Claude Code 到底在为什么付费",
              "start": 3.62,
              "end": 6.9
            },
            {
              "id": "01-04-c",
              "text": "三种付费路径有什么区别",
              "start": 6.9,
              "end": 8.79
            },
            {
              "id": "01-04-d",
              "text": "以及怎样确认钱没有从错误的接口流走",
              "start": 8.79,
              "end": 11.904
            }
          ]
        }
      ]
    },
    {
      "sceneId": "02",
      "file": "subtitles/scene-02.json",
      "segments": [
        {
          "segmentId": "02-01",
          "audioFile": "audio/scene-02/02-01.mp3",
          "cues": [
            {
              "id": "02-01-a",
              "text": "先说结论：Claude Code 这个工具本身可以免费下载",
              "start": 0.09,
              "end": 3.86
            },
            {
              "id": "02-01-b",
              "text": "你真正付的是背后模型处理请求的算力",
              "start": 3.86,
              "end": 6.84
            }
          ]
        },
        {
          "segmentId": "02-02",
          "audioFile": "audio/scene-02/02-02.mp3",
          "cues": [
            {
              "id": "02-02-a",
              "text": "你向它提问，它读取文件",
              "start": 0.09,
              "end": 2.02
            },
            {
              "id": "02-02-b",
              "text": "它返回修改方案",
              "start": 2.02,
              "end": 3.39
            },
            {
              "id": "02-02-c",
              "text": "甚至它在执行任务前进行的扩展思考",
              "start": 3.39,
              "end": 6.06
            },
            {
              "id": "02-02-d",
              "text": "都会产生需要处理的文字量",
              "start": 6.06,
              "end": 8.4
            }
          ]
        },
        {
          "segmentId": "02-03",
          "audioFile": "audio/scene-02/02-03.mp3",
          "cues": [
            {
              "id": "02-03-a",
              "text": "这个文字量通常用 token 来计量",
              "start": 0.09,
              "end": 2.65
            },
            {
              "id": "02-03-b",
              "text": "可以把 Claude Code 想成一辆出租车",
              "start": 2.65,
              "end": 4.95
            },
            {
              "id": "02-03-c",
              "text": "工具本身像是免费上车",
              "start": 4.95,
              "end": 6.84
            },
            {
              "id": "02-03-d",
              "text": "但模型处理的内容就是不断跳表的里程",
              "start": 6.84,
              "end": 9.96
            }
          ]
        },
        {
          "segmentId": "02-04",
          "audioFile": "audio/scene-02/02-04.mp3",
          "cues": [
            {
              "id": "02-04-a",
              "text": "输入的内容算输入 token",
              "start": 0.09,
              "end": 1.96
            },
            {
              "id": "02-04-b",
              "text": "模型返回的内容算输出 token",
              "start": 1.96,
              "end": 4.07
            },
            {
              "id": "02-04-c",
              "text": "而输出通常更贵",
              "start": 4.07,
              "end": 5.75
            },
            {
              "id": "02-04-d",
              "text": "你让它读一个两千行的文件",
              "start": 5.75,
              "end": 7.52
            },
            {
              "id": "02-04-e",
              "text": "整个文件都会进入输入",
              "start": 7.52,
              "end": 9.39
            },
            {
              "id": "02-04-f",
              "text": "一轮对话聊到第五十条",
              "start": 9.39,
              "end": 11.05
            },
            {
              "id": "02-04-g",
              "text": "前面的上下文也可能继续被带进后面的请求",
              "start": 11.05,
              "end": 14.35
            },
            {
              "id": "02-04-h",
              "text": "打开扩展思考",
              "start": 14.35,
              "end": 15.65
            },
            {
              "id": "02-04-i",
              "text": "思考过程也会增加处理量",
              "start": 15.65,
              "end": 17.952
            }
          ]
        },
        {
          "segmentId": "02-05",
          "audioFile": "audio/scene-02/02-05.mp3",
          "cues": [
            {
              "id": "02-05-a",
              "text": "所以花钱多少",
              "start": 0.09,
              "end": 1.32
            },
            {
              "id": "02-05-b",
              "text": "和你问了几个问题并不是简单的正相关",
              "start": 1.32,
              "end": 4.21
            },
            {
              "id": "02-05-c",
              "text": "更关键的是，每次请求带了多少上下文",
              "start": 4.21,
              "end": 7.3
            },
            {
              "id": "02-05-d",
              "text": "模型需要输出多少内容",
              "start": 7.3,
              "end": 9.17
            },
            {
              "id": "02-05-e",
              "text": "以及有没有因为方向错误反复返工",
              "start": 9.17,
              "end": 12.072
            }
          ]
        },
        {
          "segmentId": "02-06",
          "audioFile": "audio/scene-02/02-06.mp3",
          "cues": [
            {
              "id": "02-06-a",
              "text": "这也是后面所有省钱方法的基础",
              "start": 0.09,
              "end": 2.52
            },
            {
              "id": "02-06-b",
              "text": "先减少无效的上下文",
              "start": 2.52,
              "end": 4.13
            },
            {
              "id": "02-06-c",
              "text": "再考虑换什么套餐",
              "start": 4.13,
              "end": 5.88
            }
          ]
        }
      ]
    },
    {
      "sceneId": "03",
      "file": "subtitles/scene-03.json",
      "segments": [
        {
          "segmentId": "03-01",
          "audioFile": "audio/scene-03/03-01.mp3",
          "cues": [
            {
              "id": "03-01-a",
              "text": "知道钱花在 token 上以后",
              "start": 0.09,
              "end": 1.92
            },
            {
              "id": "03-01-b",
              "text": "接下来就是选择通过什么方式付费",
              "start": 1.92,
              "end": 4.64
            },
            {
              "id": "03-01-c",
              "text": "常见的有三条路",
              "start": 4.64,
              "end": 6.24
            }
          ]
        },
        {
          "segmentId": "03-02",
          "audioFile": "audio/scene-03/03-02.mp3",
          "cues": [
            {
              "id": "03-02-a",
              "text": "第一种是官方按量计费",
              "start": 0.09,
              "end": 1.83
            },
            {
              "id": "03-02-b",
              "text": "也就是 API 或 Console 这条路",
              "start": 1.83,
              "end": 4.53
            },
            {
              "id": "03-02-c",
              "text": "用多少 token 就付多少",
              "start": 4.53,
              "end": 6.3
            },
            {
              "id": "03-02-d",
              "text": "适合想用官方原生模型",
              "start": 6.3,
              "end": 8.14
            },
            {
              "id": "03-02-e",
              "text": "用量比较稳定，也能接受账单浮动的人",
              "start": 8.14,
              "end": 11.232
            }
          ]
        },
        {
          "segmentId": "03-03",
          "audioFile": "audio/scene-03/03-03.mp3",
          "cues": [
            {
              "id": "03-03-a",
              "text": "第二种是官方订阅",
              "start": 0.09,
              "end": 1.47
            },
            {
              "id": "03-03-b",
              "text": "比如 Pro、Max 或 Team",
              "start": 1.47,
              "end": 3.74
            },
            {
              "id": "03-03-c",
              "text": "它的特点是固定月费和计划额度",
              "start": 3.74,
              "end": 6.31
            },
            {
              "id": "03-03-d",
              "text": "更适合高频使用",
              "start": 6.31,
              "end": 7.61
            },
            {
              "id": "03-03-e",
              "text": "希望支出更可预期",
              "start": 7.61,
              "end": 9.12
            },
            {
              "id": "03-03-f",
              "text": "并且愿意使用官方模型的人",
              "start": 9.12,
              "end": 11.328
            }
          ]
        },
        {
          "segmentId": "03-04",
          "audioFile": "audio/scene-03/03-04.mp3",
          "cues": [
            {
              "id": "03-04-a",
              "text": "第三种是国产 Coding Plan",
              "start": 0.09,
              "end": 2.24
            },
            {
              "id": "03-04-b",
              "text": "它通常是固定月费",
              "start": 2.24,
              "end": 3.68
            },
            {
              "id": "03-04-c",
              "text": "把多个模型和工具放在一份额度里",
              "start": 3.68,
              "end": 6.26
            },
            {
              "id": "03-04-d",
              "text": "更适合国内用户",
              "start": 6.26,
              "end": 7.55
            },
            {
              "id": "03-04-e",
              "text": "对成本敏感，并且能够接受模型差异的人",
              "start": 7.55,
              "end": 10.824
            }
          ]
        },
        {
          "segmentId": "03-05",
          "audioFile": "audio/scene-03/03-05.mp3",
          "cues": [
            {
              "id": "03-05-a",
              "text": "这三条路没有一个对所有人都最优",
              "start": 0.09,
              "end": 2.72
            },
            {
              "id": "03-05-b",
              "text": "官方按量计费更灵活",
              "start": 2.72,
              "end": 4.43
            },
            {
              "id": "03-05-c",
              "text": "官方订阅更容易控制固定支出",
              "start": 4.43,
              "end": 6.64
            },
            {
              "id": "03-05-d",
              "text": "国产 Coding Plan 可能在成本和网络连接上更有优势",
              "start": 6.64,
              "end": 10.49
            },
            {
              "id": "03-05-e",
              "text": "但厂商规则、模型能力和兼容性都需要单独确认",
              "start": 10.49,
              "end": 14.472
            }
          ]
        },
        {
          "segmentId": "03-06",
          "audioFile": "audio/scene-03/03-06.mp3",
          "cues": [
            {
              "id": "03-06-a",
              "text": "尤其是价格、促销和额度都可能变化",
              "start": 0.09,
              "end": 3.27
            },
            {
              "id": "03-06-b",
              "text": "画面里的金额只能作为参考",
              "start": 3.27,
              "end": 5.47
            },
            {
              "id": "03-06-c",
              "text": "真正购买前要看官方定价页或厂商当前活动页",
              "start": 5.47,
              "end": 9.456
            }
          ]
        }
      ]
    },
    {
      "sceneId": "04",
      "file": "subtitles/scene-04.json",
      "segments": [
        {
          "segmentId": "04-01",
          "audioFile": "audio/scene-04/04-01.mp3",
          "cues": [
            {
              "id": "04-01-a",
              "text": "国产 Coding Plan 有一个特别容易踩的坑",
              "start": 0.09,
              "end": 2.72
            },
            {
              "id": "04-01-b",
              "text": "买了套餐，不代表每个请求都会消耗套餐额度",
              "start": 2.72,
              "end": 6.432
            }
          ]
        },
        {
          "segmentId": "04-02",
          "audioFile": "audio/scene-04/04-02.mp3",
          "cues": [
            {
              "id": "04-02-a",
              "text": "很多厂商同时提供两类看起来很像的接口地址",
              "start": 0.09,
              "end": 3.77
            },
            {
              "id": "04-02-b",
              "text": "一条用于 Coding Plan",
              "start": 3.77,
              "end": 5.23
            },
            {
              "id": "04-02-c",
              "text": "另一条是普通 API",
              "start": 5.23,
              "end": 7.06
            },
            {
              "id": "04-02-d",
              "text": "以源文档中的火山方舟示例来说",
              "start": 7.06,
              "end": 9.41
            },
            {
              "id": "04-02-e",
              "text": "地址里带有 /api/coding 的路径用于套餐场景",
              "start": 9.41,
              "end": 12.93
            },
            {
              "id": "04-02-f",
              "text": "而 /api/v3 则可能进入普通的按量计费路径",
              "start": 12.93,
              "end": 16.776
            }
          ]
        },
        {
          "segmentId": "04-03",
          "audioFile": "audio/scene-04/04-03.mp3",
          "cues": [
            {
              "id": "04-03-a",
              "text": "如果你本来以为自己在用固定月费套餐",
              "start": 0.09,
              "end": 2.94
            },
            {
              "id": "04-03-b",
              "text": "配置时却把地址填成了普通 API",
              "start": 2.94,
              "end": 5.67
            },
            {
              "id": "04-03-c",
              "text": "调用依然可能成功",
              "start": 5.67,
              "end": 7.09
            },
            {
              "id": "04-03-d",
              "text": "但钱已经从另一个口子流走了",
              "start": 7.09,
              "end": 9.48
            },
            {
              "id": "04-03-e",
              "text": "到了月底，套餐额度没有怎么减少",
              "start": 9.48,
              "end": 12.15
            },
            {
              "id": "04-03-f",
              "text": "按量计费那边却多出了一笔账单",
              "start": 12.15,
              "end": 14.784
            }
          ]
        },
        {
          "segmentId": "04-04",
          "audioFile": "audio/scene-04/04-04.mp3",
          "cues": [
            {
              "id": "04-04-a",
              "text": "API Key 也一样",
              "start": 0.09,
              "end": 1.72
            },
            {
              "id": "04-04-b",
              "text": "套餐专属的 Key 和普通按量计费的 Key 不能随便混用",
              "start": 1.72,
              "end": 5.592
            }
          ]
        },
        {
          "segmentId": "04-05",
          "audioFile": "audio/scene-04/04-05.mp3",
          "cues": [
            {
              "id": "04-05-a",
              "text": "所以接入 Coding Plan 以后",
              "start": 0.09,
              "end": 1.85
            },
            {
              "id": "04-05-b",
              "text": "至少核对两件事",
              "start": 1.85,
              "end": 3.26
            },
            {
              "id": "04-05-c",
              "text": "Base URL 是否是套餐专属路径",
              "start": 3.26,
              "end": 5.8
            },
            {
              "id": "04-05-d",
              "text": "API Key 是否是套餐专属版本",
              "start": 5.8,
              "end": 8.55
            },
            {
              "id": "04-05-e",
              "text": "具体地址和 Key 的格式属于厂商自己的规则",
              "start": 8.55,
              "end": 11.68
            },
            {
              "id": "04-05-f",
              "text": "动手前一定以当前官方文档和控制台为准",
              "start": 11.68,
              "end": 15.072
            }
          ]
        },
        {
          "segmentId": "04-06",
          "audioFile": "audio/scene-04/04-06.mp3",
          "cues": [
            {
              "id": "04-06-a",
              "text": "买了套餐，不等于一定走套餐",
              "start": 0.09,
              "end": 2.56
            },
            {
              "id": "04-06-b",
              "text": "配置正确，还要用量检查来验收",
              "start": 2.56,
              "end": 5.352
            }
          ]
        }
      ]
    },
    {
      "sceneId": "05",
      "file": "subtitles/scene-05.json",
      "segments": [
        {
          "segmentId": "05-01",
          "audioFile": "audio/scene-05/05-01.mp3",
          "cues": [
            {
              "id": "05-01-a",
              "text": "Claude Code 里有三个命令",
              "start": 0.09,
              "end": 1.95
            },
            {
              "id": "05-01-b",
              "text": "可以帮助你把账和配置看得更清楚",
              "start": 1.95,
              "end": 4.704
            }
          ]
        },
        {
          "segmentId": "05-02",
          "audioFile": "audio/scene-05/05-02.mp3",
          "cues": [
            {
              "id": "05-02-a",
              "text": "第一个是 /usage",
              "start": 0.09,
              "end": 1.65
            },
            {
              "id": "05-02-b",
              "text": "它主要看当前会话用了多少 token",
              "start": 1.65,
              "end": 4.07
            },
            {
              "id": "05-02-c",
              "text": "并给出一个本地估算的花销",
              "start": 4.07,
              "end": 6.17
            },
            {
              "id": "05-02-d",
              "text": "这个数字适合帮助你建立感觉",
              "start": 6.17,
              "end": 8.38
            },
            {
              "id": "05-02-e",
              "text": "但它不一定等于最终账单",
              "start": 8.38,
              "end": 10.08
            },
            {
              "id": "05-02-f",
              "text": "权威金额还是要以 Console 的使用页面为准",
              "start": 10.08,
              "end": 13.392
            }
          ]
        },
        {
          "segmentId": "05-03",
          "audioFile": "audio/scene-05/05-03.mp3",
          "cues": [
            {
              "id": "05-03-a",
              "text": "第二个是 /usage-credits",
              "start": 0.09,
              "end": 2.14
            },
            {
              "id": "05-03-b",
              "text": "它可以在官方 Pro 或 Max 计划中设置每月使用上限",
              "start": 2.14,
              "end": 5.87
            },
            {
              "id": "05-03-c",
              "text": "达到上限以后，Claude Code 会提醒你是否提高或移除",
              "start": 5.87,
              "end": 9.34
            },
            {
              "id": "05-03-d",
              "text": "限制。它不是所有国产 Coding Plan 的统一额度开关",
              "start": 9.34,
              "end": 13.31
            },
            {
              "id": "05-03-e",
              "text": "国产套餐的额度仍然要看对应厂商的控制台",
              "start": 13.31,
              "end": 16.704
            }
          ]
        },
        {
          "segmentId": "05-04",
          "audioFile": "audio/scene-05/05-04.mp3",
          "cues": [
            {
              "id": "05-04-a",
              "text": "第三个是 /status",
              "start": 0.09,
              "end": 1.84
            },
            {
              "id": "05-04-b",
              "text": "它用来核对版本",
              "start": 1.84,
              "end": 3.09
            },
            {
              "id": "05-04-c",
              "text": "模型、账户和连通性",
              "start": 3.09,
              "end": 5.36
            },
            {
              "id": "05-04-d",
              "text": "尤其当你配置了代理",
              "start": 5.36,
              "end": 6.79
            },
            {
              "id": "05-04-e",
              "text": "网关或第三方 Coding Plan 时",
              "start": 6.79,
              "end": 9.16
            },
            {
              "id": "05-04-f",
              "text": "不能只看 Claude Code 能不能启动",
              "start": 9.16,
              "end": 11.47
            },
            {
              "id": "05-04-g",
              "text": "还要确认它使用的模型和连接状态是不是你",
              "start": 11.47,
              "end": 14.39
            },
            {
              "id": "05-04-h",
              "text": "预期的结果",
              "start": 14.39,
              "end": 15.696
            }
          ]
        },
        {
          "segmentId": "05-05",
          "audioFile": "audio/scene-05/05-05.mp3",
          "cues": [
            {
              "id": "05-05-a",
              "text": "可以把这三个命令记成一句话：/usage 看明细",
              "start": 0.09,
              "end": 3.33
            },
            {
              "id": "05-05-b",
              "text": "/usage-credits 设上限，/status 核配置",
              "start": 3.33,
              "end": 6.792
            }
          ]
        }
      ]
    },
    {
      "sceneId": "06",
      "file": "subtitles/scene-06.json",
      "segments": [
        {
          "segmentId": "06-01",
          "audioFile": "audio/scene-06/06-01.mp3",
          "cues": [
            {
              "id": "06-01-a",
              "text": "换一个更便宜的套餐",
              "start": 0.09,
              "end": 1.57
            },
            {
              "id": "06-01-b",
              "text": "往往只是下策",
              "start": 1.57,
              "end": 2.99
            },
            {
              "id": "06-01-c",
              "text": "真正稳定的省钱方法",
              "start": 2.99,
              "end": 4.56
            },
            {
              "id": "06-01-d",
              "text": "是让模型少读没用的内容",
              "start": 4.56,
              "end": 6.37
            },
            {
              "id": "06-01-e",
              "text": "少走没必要的弯路",
              "start": 6.37,
              "end": 7.992
            }
          ]
        },
        {
          "segmentId": "06-02",
          "audioFile": "audio/scene-06/06-02.mp3",
          "cues": [
            {
              "id": "06-02-a",
              "text": "第一个习惯，不相关的任务之间使用 /clear",
              "start": 0.09,
              "end": 3.26
            },
            {
              "id": "06-02-b",
              "text": "上午修 Bug，下午写新功能",
              "start": 3.26,
              "end": 5.43
            },
            {
              "id": "06-02-c",
              "text": "不要把所有事情都塞进同一个长会话里",
              "start": 5.43,
              "end": 8.4
            },
            {
              "id": "06-02-d",
              "text": "旧上下文会在后续请求中重复出现",
              "start": 8.4,
              "end": 11.23
            },
            {
              "id": "06-02-e",
              "text": "任务之间清空，能避免这部分浪费",
              "start": 11.23,
              "end": 13.944
            }
          ]
        },
        {
          "segmentId": "06-03",
          "audioFile": "audio/scene-06/06-03.mp3",
          "cues": [
            {
              "id": "06-03-a",
              "text": "第二个习惯，日常任务默认使用 Sonnet",
              "start": 0.09,
              "end": 3.19
            },
            {
              "id": "06-03-b",
              "text": "普通改代码、写函数和调小问题",
              "start": 3.19,
              "end": 5.91
            },
            {
              "id": "06-03-c",
              "text": "通常不需要一直使用更贵的 Opus",
              "start": 5.91,
              "end": 8.49
            },
            {
              "id": "06-03-d",
              "text": "复杂架构和多步推理",
              "start": 8.49,
              "end": 10.13
            },
            {
              "id": "06-03-e",
              "text": "再考虑切换到更强的模型",
              "start": 10.13,
              "end": 12.432
            }
          ]
        },
        {
          "segmentId": "06-04",
          "audioFile": "audio/scene-06/06-04.mp3",
          "cues": [
            {
              "id": "06-04-a",
              "text": "第三个习惯，复杂任务先用 plan mode",
              "start": 0.09,
              "end": 3.12
            },
            {
              "id": "06-04-b",
              "text": "先让模型探索代码库",
              "start": 3.12,
              "end": 4.76
            },
            {
              "id": "06-04-c",
              "text": "给出计划，再决定是否执行",
              "start": 4.76,
              "end": 7.06
            },
            {
              "id": "06-04-d",
              "text": "比方向错了以后修改七八个文件更省 token",
              "start": 7.06,
              "end": 10.632
            }
          ]
        },
        {
          "segmentId": "06-05",
          "audioFile": "audio/scene-06/06-05.mp3",
          "cues": [
            {
              "id": "06-05-a",
              "text": "第四个习惯，把提示写具体",
              "start": 0.09,
              "end": 2.47
            },
            {
              "id": "06-05-b",
              "text": "与其说“帮我改进这个代码库”",
              "start": 2.47,
              "end": 4.51
            },
            {
              "id": "06-05-c",
              "text": "不如指出具体文件",
              "start": 4.51,
              "end": 5.89
            },
            {
              "id": "06-05-d",
              "text": "函数和目标",
              "start": 5.89,
              "end": 7.2
            },
            {
              "id": "06-05-e",
              "text": "范围越清楚，模型越不需要到处扫描",
              "start": 7.2,
              "end": 10.07
            },
            {
              "id": "06-05-f",
              "text": "也越不容易把时间和 token 花在无关内容上",
              "start": 10.07,
              "end": 13.272
            }
          ]
        },
        {
          "segmentId": "06-06",
          "audioFile": "audio/scene-06/06-06.mp3",
          "cues": [
            {
              "id": "06-06-a",
              "text": "省钱不是单纯换一个便宜模型",
              "start": 0.09,
              "end": 2.45
            },
            {
              "id": "06-06-b",
              "text": "而是清掉陈旧上下文",
              "start": 2.45,
              "end": 4.06
            },
            {
              "id": "06-06-c",
              "text": "用合适的模型、减少返工",
              "start": 4.06,
              "end": 6.09
            },
            {
              "id": "06-06-d",
              "text": "并缩小搜索范围",
              "start": 6.09,
              "end": 7.752
            }
          ]
        }
      ]
    },
    {
      "sceneId": "07",
      "file": "subtitles/scene-07.json",
      "segments": [
        {
          "segmentId": "07-01",
          "audioFile": "audio/scene-07/07-01.mp3",
          "cues": [
            {
              "id": "07-01-a",
              "text": "最后，把前面的内容变成一套五分钟就能",
              "start": 0.09,
              "end": 3.07
            },
            {
              "id": "07-01-b",
              "text": "跑一遍的动作",
              "start": 3.07,
              "end": 4.44
            }
          ]
        },
        {
          "segmentId": "07-02",
          "audioFile": "audio/scene-07/07-02.mp3",
          "cues": [
            {
              "id": "07-02-a",
              "text": "第一步，在项目目录里启动 Claude Code",
              "start": 0.09,
              "end": 2.77
            },
            {
              "id": "07-02-b",
              "text": "然后输入 /status",
              "start": 2.77,
              "end": 4.47
            },
            {
              "id": "07-02-c",
              "text": "确认当前使用的模型",
              "start": 4.47,
              "end": 6.04
            },
            {
              "id": "07-02-d",
              "text": "账户和连通性都符合预期",
              "start": 6.04,
              "end": 8.48
            },
            {
              "id": "07-02-e",
              "text": "如果你使用国产 Coding Plan",
              "start": 8.48,
              "end": 10.37
            },
            {
              "id": "07-02-f",
              "text": "还要回到环境变量和厂商控制台",
              "start": 10.37,
              "end": 12.72
            },
            {
              "id": "07-02-g",
              "text": "确认 Base URL 走的是套餐路径",
              "start": 12.72,
              "end": 15.528
            }
          ]
        },
        {
          "segmentId": "07-03",
          "audioFile": "audio/scene-07/07-03.mp3",
          "cues": [
            {
              "id": "07-03-a",
              "text": "第二步，先让它做一个很小的任务",
              "start": 0.09,
              "end": 2.67
            },
            {
              "id": "07-03-b",
              "text": "比如看看当前目录有哪些文件",
              "start": 2.67,
              "end": 4.9
            },
            {
              "id": "07-03-c",
              "text": "简单说明项目是做什么的",
              "start": 4.9,
              "end": 7.09
            },
            {
              "id": "07-03-d",
              "text": "任务完成后输入 /usage",
              "start": 7.09,
              "end": 9.19
            },
            {
              "id": "07-03-e",
              "text": "记下这次简单操作的用量和本地估算金额",
              "start": 9.19,
              "end": 12.552
            }
          ]
        },
        {
          "segmentId": "07-04",
          "audioFile": "audio/scene-07/07-04.mp3",
          "cues": [
            {
              "id": "07-04-a",
              "text": "这个数字不是固定价格",
              "start": 0.09,
              "end": 2.07
            },
            {
              "id": "07-04-b",
              "text": "而是你的个人基准",
              "start": 2.07,
              "end": 3.61
            },
            {
              "id": "07-04-c",
              "text": "以后某次对话突然变得特别贵",
              "start": 3.61,
              "end": 5.96
            },
            {
              "id": "07-04-d",
              "text": "你就有一个可以对照的参照物",
              "start": 5.96,
              "end": 8.064
            }
          ]
        },
        {
          "segmentId": "07-05",
          "audioFile": "audio/scene-07/07-05.mp3",
          "cues": [
            {
              "id": "07-05-a",
              "text": "第三步，如果你使用的是官方 Pro 或 Max 计划",
              "start": 0.09,
              "end": 3.44
            },
            {
              "id": "07-05-b",
              "text": "可以输入 /usage-credits",
              "start": 3.44,
              "end": 5.19
            },
            {
              "id": "07-05-c",
              "text": "给自己设置一个能够接受的月度上限",
              "start": 5.19,
              "end": 8
            },
            {
              "id": "07-05-d",
              "text": "国产 Coding Plan 用户则要在厂商控制台里管理对应",
              "start": 8,
              "end": 11.52
            },
            {
              "id": "07-05-e",
              "text": "套餐的额度",
              "start": 11.52,
              "end": 12.768
            }
          ]
        },
        {
          "segmentId": "07-06",
          "audioFile": "audio/scene-07/07-06.mp3",
          "cues": [
            {
              "id": "07-06-a",
              "text": "这样一来，你就完成了一条最小闭环",
              "start": 0.09,
              "end": 2.63
            },
            {
              "id": "07-06-b",
              "text": "先核对配置，再做一个小任务",
              "start": 2.63,
              "end": 4.88
            },
            {
              "id": "07-06-c",
              "text": "查看用量，最后设置能够使用的边界",
              "start": 4.88,
              "end": 7.992
            }
          ]
        }
      ]
    },
    {
      "sceneId": "08",
      "file": "subtitles/scene-08.json",
      "segments": [
        {
          "segmentId": "08-01",
          "audioFile": "audio/scene-08/08-01.mp3",
          "cues": [
            {
              "id": "08-01-a",
              "text": "这一篇只记住三件事",
              "start": 0.09,
              "end": 2.088
            }
          ]
        },
        {
          "segmentId": "08-02",
          "audioFile": "audio/scene-08/08-02.mp3",
          "cues": [
            {
              "id": "08-02-a",
              "text": "第一，Claude Code 工具本身不是主要的计费来源",
              "start": 0.09,
              "end": 3.57
            },
            {
              "id": "08-02-b",
              "text": "模型处理的输入、输出和上下文才",
              "start": 3.57,
              "end": 6.29
            },
            {
              "id": "08-02-c",
              "text": "是成本核心",
              "start": 6.29,
              "end": 7.584
            }
          ]
        },
        {
          "segmentId": "08-03",
          "audioFile": "audio/scene-08/08-03.mp3",
          "cues": [
            {
              "id": "08-03-a",
              "text": "第二，按量计费",
              "start": 0.09,
              "end": 1.51
            },
            {
              "id": "08-03-b",
              "text": "官方订阅和国产 Coding Plan 是三种不同的取舍",
              "start": 1.51,
              "end": 4.9
            },
            {
              "id": "08-03-c",
              "text": "没有适合所有人的唯一答案",
              "start": 4.9,
              "end": 6.96
            },
            {
              "id": "08-03-d",
              "text": "买了 Coding Plan 以后",
              "start": 6.96,
              "end": 8.3
            },
            {
              "id": "08-03-e",
              "text": "还要确认 Base URL 和 API Key 真的",
              "start": 8.3,
              "end": 11.02
            },
            {
              "id": "08-03-f",
              "text": "指向套餐路径",
              "start": 11.02,
              "end": 12.456
            }
          ]
        },
        {
          "segmentId": "08-04",
          "audioFile": "audio/scene-08/08-04.mp3",
          "cues": [
            {
              "id": "08-04-a",
              "text": "第三，/usage 看明细，/status 核配置，/clear 勤清",
              "start": 0.09,
              "end": 3.78
            },
            {
              "id": "08-04-b",
              "text": "上下文，再配合合适的模型和具体提示",
              "start": 3.78,
              "end": 6.91
            },
            {
              "id": "08-04-c",
              "text": "才能让同样的任务少烧 token",
              "start": 6.91,
              "end": 9.36
            }
          ]
        },
        {
          "segmentId": "08-05",
          "audioFile": "audio/scene-08/08-05.mp3",
          "cues": [
            {
              "id": "08-05-a",
              "text": "账算明白了，配置路径也核对了",
              "start": 0.09,
              "end": 2.54
            },
            {
              "id": "08-05-b",
              "text": "下一步就该真正启动 Claude Code",
              "start": 2.54,
              "end": 5.016
            }
          ]
        },
        {
          "segmentId": "08-06",
          "audioFile": "audio/scene-08/08-06.mp3",
          "cues": [
            {
              "id": "08-06-a",
              "text": "下一集，我们进入 07《第一次使用",
              "start": 0.09,
              "end": 2.78
            },
            {
              "id": "08-06-b",
              "text": "跑通第一个例子》，从一个最小的真实项目开始",
              "start": 2.78,
              "end": 5.77
            },
            {
              "id": "08-06-c",
              "text": "亲手跑通“想、做",
              "start": 5.77,
              "end": 7.27
            },
            {
              "id": "08-06-d",
              "text": "看”的代理循环",
              "start": 7.27,
              "end": 8.688
            }
          ]
        }
      ]
    }
  ]
}
