          "cues": [
            {
              "id": "08-01-a",
              "text": "最后，把这些概念合成一套完整的工作模型。",
              "start": 0.09,
              "end": 3.72
            }
          ]
        },
        {
          "segmentId": "08-02",
          "audioFile": "audio/scene-08/08-02.mp3",
          "cues": [
            {
              "id": "08-02-a",
              "text": "你先给出任务目标，",
              "start": 0.09,
              "end": 1.41
            },
            {
              "id": "08-02-b",
              "text": "Agent 围绕目标持续行动；",
              "start": 1.41,
              "end": 3.41
            },
            {
              "id": "08-02-c",
              "text": "Sandbox 划定当前边界，",
              "start": 3.41,
              "end": 5.29
            },
            {
