              "end": 7.392
            }
          ]
        },
        {
          "segmentId": "08-04",
          "audioFile": "audio/scene-08/08-04.mp3",
          "cues": [
            {
              "id": "08-04-a",
              "text": "想稳定地使用 Codex，",
