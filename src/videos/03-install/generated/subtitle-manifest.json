{
  "schemaVersion": "1.0",
  "videoId": "03-install",
  "scenes": [
    {
      "sceneId": "01",
      "file": "subtitles/scene-01.json",
      "segments": [
        {
          "segmentId": "01-01",
          "audioFile": "audio/scene-01/01-01.mp3",
          "cues": [
            {
              "id": "01-01-a",
              "text": "先别急着复制安装命令。",
              "start": 0.09,
              "end": 2.17
            },
            {
              "id": "01-01-b",
              "text": "搜到一条命令，不代表它就是你的正确起点。",
              "start": 2.17,
              "end": 5.55
            },
            {
              "id": "01-01-c",
              "text": "你打算从桌面 App 进入，",
              "start": 5.55,
              "end": 7.31
            },
            {
              "id": "01-01-d",
              "text": "还是在终端里工作？",
              "start": 7.31,
              "end": 8.95
            },
            {
              "id": "01-01-e",
              "text": "使用 ChatGPT 账号还是 API key？",
              "start": 8.95,
              "end": 11.97
            },
            {
              "id": "01-01-f",
              "text": "网络能否顺利下载？",
              "start": 11.97,
              "end": 13.75
            },
            {
              "id": "01-01-g",
              "text": "这些条件都会影响后面的步骤。",
              "start": 13.75,
              "end": 16.25
            },
            {
              "id": "01-01-h",
              "text": "安装 Codex 的第一步，",
              "start": 16.25,
              "end": 17.91
            },
            {
              "id": "01-01-i",
              "text": "不是立刻执行命令，",
              "start": 17.91,
              "end": 19.36
            },
            {
              "id": "01-01-j",
              "text": "而是先确认自己的启动路径。",
              "start": 19.36,
              "end": 21.6
            }
          ]
        }
      ]
    },
    {
      "sceneId": "02",
      "file": "subtitles/scene-02.json",
      "segments": [
        {
          "segmentId": "02-01",
          "audioFile": "audio/scene-02/02-01.mp3",
          "cues": [
            {
              "id": "02-01-a",
              "text": "先按工作方式选择入口。",
              "start": 0.09,
              "end": 2.22
            },
            {
              "id": "02-01-b",
              "text": "桌面 App 适合 macOS 或 Windows 上以图形界面管理项目",
              "start": 2.22,
              "end": 6.06
            },
            {
              "id": "02-01-c",
              "text": "的工作流。CLI 更适合终端操作、",
              "start": 6.06,
              "end": 9.07
            },
            {
              "id": "02-01-d",
              "text": "自动化任务，以及希望在三个主要平台保持一致体验",
              "start": 9.07,
              "end": 12.69
            },
            {
              "id": "02-01-e",
              "text": "的场景。Linux 用户直接从 CLI 开始。",
              "start": 12.69,
              "end": 16.32
            },
            {
              "id": "02-01-f",
              "text": "选择 CLI 时，",
              "start": 16.32,
              "end": 17.83
            },
            {
              "id": "02-01-g",
              "text": "官方独立安装器不要求你预先安装 Node.",
              "start": 17.83,
              "end": 20.48
            },
            {
              "id": "02-01-h",
              "text": "js。两种入口不是谁替代谁，",
              "start": 20.48,
              "end": 23.53
            },
            {
              "id": "02-01-i",
              "text": "而是让你用更顺手的方式完成同一类工作。",
              "start": 23.53,
              "end": 26.688
            }
          ]
        }
      ]
    },
    {
      "sceneId": "03",
      "file": "subtitles/scene-03.json",
      "segments": [
        {
          "segmentId": "03-01",
          "audioFile": "audio/scene-03/03-01.mp3",
          "cues": [
            {
              "id": "03-01-a",
              "text": "选好入口后，再让安装方式匹配你的系统和运行",
              "start": 0.09,
              "end": 3.51
            },
            {
              "id": "03-01-b",
              "text": "环境。macOS 要先确认芯片架构；",
              "start": 3.51,
              "end": 6.59
            },
            {
              "id": "03-01-c",
              "text": "macOS 和 Linux 可以沿着 Shell 路径完成安装。",
              "start": 6.59,
              "end": 10.1
            },
            {
              "id": "03-01-d",
              "text": "Windows 则要在 PowerShell 原生环境、",
              "start": 10.1,
              "end": 12.46
            },
            {
              "id": "03-01-e",
              "text": "原生沙箱和 WSL2 之间作选择。",
              "start": 12.46,
              "end": 15.61
            },
            {
              "id": "03-01-f",
              "text": "默认优先考虑原生的 elevated 沙箱；",
              "start": 15.61,
              "end": 18.42
            },
            {
              "id": "03-01-g",
              "text": "如果系统策略不允许，",
              "start": 18.42,
              "end": 19.92
            },
            {
              "id": "03-01-h",
              "text": "再使用 unelevated。",
              "start": 19.92,
              "end": 21.64
            },
            {
              "id": "03-01-i",
              "text": "只有项目依赖 Linux 工具链，",
              "start": 21.64,
              "end": 23.68
            },
            {
              "id": "03-01-j",
              "text": "或者项目本来就在 WSL2 时，",
              "start": 23.68,
              "end": 26.22
            },
            {
              "id": "03-01-k",
              "text": "才选择 WSL2。",
              "start": 26.22,
              "end": 28.17
            },
            {
              "id": "03-01-l",
              "text": "使用 WSL2 时，",
              "start": 28.17,
              "end": 29.97
            },
            {
              "id": "03-01-m",
              "text": "把项目放在 Linux 文件系统里，",
              "start": 29.97,
              "end": 32.26
            },
            {
              "id": "03-01-n",
              "text": "避免放在 /mnt/c/... ",
              "start": 32.26,
              "end": 34.11
            },
            {
              "id": "03-01-o",
              "text": "这类跨文件系统路径。",
              "start": 34.11,
              "end": 36.096
            }
          ]
        }
      ]
    },
    {
      "sceneId": "04",
      "file": "subtitles/scene-04.json",
      "segments": [
        {
          "segmentId": "04-01",
          "audioFile": "audio/scene-04/04-01.mp3",
          "cues": [
            {
              "id": "04-01-a",
              "text": "安装过程结束后，",
              "start": 0.09,
              "end": 1.41
            },
            {
              "id": "04-01-b",
              "text": "先不要急着开始任务。",
              "start": 1.41,
              "end": 3.11
            },
            {
              "id": "04-01-c",
              "text": "打开一个新的终端，",
              "start": 3.11,
              "end": 4.42
            },
            {
              "id": "04-01-d",
              "text": "运行 codex --version。",
              "start": 4.42,
              "end": 6.14
            },
            {
              "id": "04-01-e",
              "text": "只有终端能够找到 codex，",
              "start": 6.14,
              "end": 7.96
            },
            {
              "id": "04-01-f",
              "text": "并显示版本号，才说明 CLI 已经可以执行。",
              "start": 7.96,
              "end": 11.64
            },
            {
              "id": "04-01-g",
              "text": "这里不需要追求某个固定版本；",
              "start": 11.64,
              "end": 13.89
            },
            {
              "id": "04-01-h",
              "text": "版本号的作用只是确认命令可用。",
              "start": 13.89,
              "end": 16.53
            },
            {
              "id": "04-01-i",
              "text": "想查看可用子命令或升级方式，",
              "start": 16.53,
              "end": 18.97
            },
            {
              "id": "04-01-j",
              "text": "可以运行 codex --help。",
              "start": 18.97,
              "end": 20.99
            },
            {
              "id": "04-01-k",
              "text": "如果看到 command not found 一类提示，",
              "start": 20.99,
              "end": 23.31
            },
            {
              "id": "04-01-l",
              "text": "先检查 PATH 设置和是否存在多重安装，",
              "start": 23.31,
              "end": 26.34
            },
            {
              "id": "04-01-m",
              "text": "不要马上重装。",
              "start": 26.34,
              "end": 27.744
            }
          ]
        }
      ]
    },
    {
      "sceneId": "05",
      "file": "subtitles/scene-05.json",
      "segments": [
        {
          "segmentId": "05-01",
          "audioFile": "audio/scene-05/05-01.mp3",
          "cues": [
            {
              "id": "05-01-a",
              "text": "命令能执行，还不等于已经能开始工作。",
              "start": 0.09,
              "end": 3.08
            },
            {
              "id": "05-01-b",
              "text": "接下来需要完成登录，",
              "start": 3.08,
              "end": 4.66
            },
            {
              "id": "05-01-c",
              "text": "把本地 CLI 连接到实际可用的账号和用量边界。",
              "start": 4.66,
              "end": 8.59
            },
            {
              "id": "05-01-d",
              "text": "你可以使用 ChatGPT 账号，",
              "start": 8.59,
              "end": 10.65
            },
            {
              "id": "05-01-e",
              "text": "也可以使用 API key；",
              "start": 10.65,
              "end": 12.35
            },
            {
              "id": "05-01-f",
              "text": "两种方式的能力和计费边界不同。",
              "start": 12.35,
              "end": 14.98
            },
            {
              "id": "05-01-g",
              "text": "在正常的图形环境里，",
              "start": 14.98,
              "end": 16.54
            },
            {
              "id": "05-01-h",
              "text": "使用浏览器登录最直接。",
              "start": 16.54,
              "end": 18.62
            },
            {
              "id": "05-01-i",
              "text": "远程服务器、headless 环境，",
              "start": 18.62,
              "end": 20.59
            },
            {
              "id": "05-01-j",
              "text": "或 localhost 回调受阻时，",
              "start": 20.59,
              "end": 22.42
            },
            {
              "id": "05-01-k",
              "text": "改用设备码登录。",
              "start": 22.42,
              "end": 23.95
            },
            {
              "id": "05-01-l",
              "text": "CLI 和 IDE 扩展会共享登录缓存，",
              "start": 23.95,
              "end": 26.93
            },
            {
              "id": "05-01-m",
              "text": "所以凭据要像密码一样保护。",
              "start": 26.93,
              "end": 29.0
            },
            {
              "id": "05-01-n",
              "text": "认证缓存迁移和 SSH 端口转发，",
              "start": 29.0,
              "end": 31.92
            },
            {
              "id": "05-01-o",
              "text": "只在明确需要时处理，",
              "start": 31.92,
              "end": 33.43
            },
            {
              "id": "05-01-p",
              "text": "也不要暴露凭据。",
              "start": 33.43,
              "end": 34.848
            }
          ]
        }
      ]
    },
    {
      "sceneId": "06",
      "file": "subtitles/scene-06.json",
      "segments": [
        {
          "segmentId": "06-01",
          "audioFile": "audio/scene-06/06-01.mp3",
          "cues": [
            {
              "id": "06-01-a",
              "text": "遇到问题时，回到失败发生的边界，",
              "start": 0.09,
              "end": 2.6
            },
            {
              "id": "06-01-b",
              "text": "不要靠盲目重装碰运气。",
              "start": 2.6,
              "end": 4.57
            },
            {
              "id": "06-01-c",
              "text": "找不到 codex，就检查 PATH 和多重安装。",
              "start": 4.57,
              "end": 7.85
            },
            {
              "id": "06-01-d",
              "text": "下载超时，就检查网络连通性。",
              "start": 7.85,
              "end": 10.55
            },
            {
              "id": "06-01-e",
              "text": "浏览器登录失败，",
              "start": 10.55,
              "end": 11.83
            },
            {
              "id": "06-01-f",
              "text": "就检查回调环境，",
              "start": 11.83,
              "end": 13.22
            },
            {
              "id": "06-01-g",
              "text": "必要时改用设备码。",
              "start": 13.22,
              "end": 14.99
            },
            {
              "id": "06-01-h",
              "text": "Windows 沙箱启动失败，",
              "start": 14.99,
              "end": 16.58
            },
            {
              "id": "06-01-i",
              "text": "就回到系统权限策略和运行环境的选择。",
              "start": 16.58,
              "end": 19.83
            },
            {
              "id": "06-01-j",
              "text": "要是通过 npm 安装时遇到权限错误，",
              "start": 19.83,
              "end": 22.78
            },
            {
              "id": "06-01-k",
              "text": "也不要直接使用 sudo；",
              "start": 22.78,
              "end": 24.33
            },
            {
              "id": "06-01-l",
              "text": "应当修正用户目录里的 Node 环境，",
              "start": 24.33,
              "end": 26.56
            },
            {
              "id": "06-01-m",
              "text": "或者改用官方独立安装器。",
              "start": 26.56,
              "end": 28.79
            },
            {
              "id": "06-01-n",
              "text": "按现象找根因，",
              "start": 28.79,
              "end": 30.03
            },
            {
              "id": "06-01-o",
              "text": "才能让每次修复都落在正确的位置。",
              "start": 30.03,
              "end": 32.904
            }
          ]
        }
      ]
    },
    {
      "sceneId": "07",
      "file": "subtitles/scene-07.json",
      "segments": [
        {
          "segmentId": "07-01",
          "audioFile": "audio/scene-07/07-01.mp3",
          "cues": [
            {
              "id": "07-01-a",
              "text": "现在把整条启动路径串起来：",
              "start": 0.09,
              "end": 2.22
            },
            {
              "id": "07-01-b",
              "text": "先选择入口，再匹配系统与环境；",
              "start": 2.22,
              "end": 4.9
            },
            {
              "id": "07-01-c",
              "text": "接着用版本号验证命令，",
              "start": 4.9,
              "end": 6.57
            },
            {
              "id": "07-01-d",
              "text": "完成登录；最后按失败现象定位根因。",
              "start": 6.57,
              "end": 9.81
            },
            {
              "id": "07-01-e",
              "text": "安装完成，不是一条命令结束，",
              "start": 9.81,
              "end": 12.15
            },
            {
              "id": "07-01-f",
              "text": "而是你已经拥有一条可选择、",
              "start": 12.15,
              "end": 14.26
            },
            {
              "id": "07-01-g",
              "text": "可验证、可登录、",
              "start": 14.26,
              "end": 15.68
            },
            {
              "id": "07-01-h",
              "text": "也可恢复的稳定起点。",
              "start": 15.68,
              "end": 17.62
            },
            {
              "id": "07-01-i",
              "text": "你不必背下所有平台的命令，",
              "start": 17.62,
              "end": 19.67
            },
            {
              "id": "07-01-j",
              "text": "只要能为自己的条件选出完整路径。",
              "start": 19.67,
              "end": 22.47
            },
            {
              "id": "07-01-k",
              "text": "下一集会继续讲清楚：",
              "start": 22.47,
              "end": 24.22
            },
            {
              "id": "07-01-l",
              "text": "使用 ChatGPT 套餐登录和使用 API key 登录时，",
              "start": 24.22,
              "end": 27.86
            },
            {
              "id": "07-01-m",
              "text": "用量边界与计费选择到底有什么区别。",
              "start": 27.86,
              "end": 30.864
            }
          ]
        }
      ]
    }
  ]
}
