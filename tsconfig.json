{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": ["src", "videos/*/src", "remotion.config.ts"],
  "exclude": ["node_modules", "videos/*/render-input", "videos/*/output", "videos/*/preview", "videos/*/work"]
}
