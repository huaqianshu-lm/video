{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "videoSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "workflow": {
      "const": "narrated-tutorial-v1"
    },
    "productionContract": {
      "const": "storyboard-v1"
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "seriesSelection": {
      "type": [
        "object",
        "null"
      ]
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "narrationRef": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "excerpt"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "focus": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "type": "string",
            "minLength": 1
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "sourceRef": {
                  "type": "integer",
                  "minimum": 0
                },
                "enter": {
                  "type": "string",
                  "minLength": 1
                },
                "exit": {
                  "type": "string",
                  "minLength": 1
                },
                "retain": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text",
                "enter",
                "exit",
                "retain"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "after": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger": {
                  "type": "object",
                  "properties": {
                    "sceneId": {
                      "type": "string",
                      "pattern": "^[0-9]{2}$"
                    },
                    "anchor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "occurrence": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "sceneId",
                    "anchor",
                    "occurrence"
                  ],
                  "additionalProperties": false
                },
                "role": {
                  "enum": [
                    "content",
                    "next-episode"
                  ]
                }
              },
              "required": [
                "id",
                "before",
                "action",
                "after",
                "trigger"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "holds": {
            "type": "string",
            "minLength": 1
          },
          "handoff": {
            "type": "string",
            "minLength": 1
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "diagrams": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "caption"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          }
        },
        "required": [
          "id",
          "objective",
          "narrationRef",
          "sourceRefs",
          "focus",
          "layout",
          "elements",
          "events",
          "holds",
          "handoff",
          "assets",
          "implementation"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "videoSlug",
    "workflow",
    "productionContract",
    "style",
    "seriesSelection",
    "scenes"
  ],
  "additionalProperties": false
}
