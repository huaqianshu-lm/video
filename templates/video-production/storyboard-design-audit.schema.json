{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-design-audit-v1",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "kind": {
      "const": "storyboard-design-audit"
    },
    "ruleVersion": {
      "const": "storyboard-execution-quality-v1"
    },
    "videoSlug": {
      "type": "string",
      "minLength": 1
    },
    "inputVersion": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "storyboardFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "narrationFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "checkId": {
            "enum": [
              "SQ-1",
              "SQ-2",
              "SQ-3",
              "SQ-4",
              "SQ-5",
              "SQ-6",
              "SQ-7",
              "SQ-8",
              "SQ-9",
              "SQ-10"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "pending"
            ]
          },
          "elementIds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          },
          "note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "sceneId",
          "eventId",
          "checkId",
          "result",
          "elementIds",
          "evidence",
          "note"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "ruleVersion",
    "videoSlug",
    "inputVersion",
    "storyboardFingerprint",
    "narrationFingerprint",
    "checks"
  ],
  "additionalProperties": false
}
