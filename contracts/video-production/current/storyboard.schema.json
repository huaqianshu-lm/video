{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-v3",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "videoSlug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "workflow": {
      "const": "narrated-tutorial-v1"
    },
    "productionContract": {
      "const": "storyboard-v1"
    },
    "style": {
      "type": "string",
      "minLength": 1
    },
    "seriesSelection": {
      "type": [
        "object",
        "null"
      ]
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "narrationRef": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "excerpt": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "excerpt"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "focus": {
            "type": "string",
            "minLength": 1
          },
          "layout": {
            "type": "string",
            "minLength": 1
          },
          "elements": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string"
                },
                "sourceRef": {
                  "type": "integer",
                  "minimum": 0
                },
                "enter": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "scene",
                        "event"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "edge": {
                      "enum": [
                        "start",
                        "complete",
                        "end"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "edge"
                  ],
                  "additionalProperties": false
                },
                "exit": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "scene",
                        "event"
                      ]
                    },
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "edge": {
                      "enum": [
                        "start",
                        "complete",
                        "end"
                      ]
                    }
                  },
                  "required": [
                    "type",
                    "id",
                    "edge"
                  ],
                  "additionalProperties": false
                },
                "retain": {
                  "type": "string"
                },
                "type": {
                  "type": "string",
                  "minLength": 1
                },
                "role": {
                  "enum": [
                    "subject",
                    "request",
                    "result",
                    "state",
                    "annotation",
                    "context-title"
                  ]
                },
                "parentId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "layout": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    },
                    "width": {
                      "type": "number",
                      "minimum": 1
                    },
                    "height": {
                      "type": "number",
                      "minimum": 1
                    },
                    "layer": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "mode": {
                      "enum": [
                        "box",
                        "slot"
                      ]
                    },
                    "slot": {
                      "enum": [
                        "primary",
                        "left",
                        "right",
                        "top",
                        "bottom"
                      ]
                    }
                  },
                  "required": [
                    "mode",
                    "layer"
                  ],
                  "additionalProperties": false
                },
                "geometry": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "text",
                "enter",
                "exit",
                "retain",
                "type",
                "role",
                "parentId",
                "purpose",
                "layout",
                "sourceRef"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "events": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "before": {
                  "type": "string",
                  "minLength": 1
                },
                "action": {
                  "type": "string",
                  "minLength": 1
                },
                "after": {
                  "type": "string",
                  "minLength": 1
                },
                "trigger": {
                  "type": "object",
                  "properties": {
                    "sceneId": {
                      "type": "string",
                      "pattern": "^[0-9]{2}$"
                    },
                    "anchor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "occurrence": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "sceneId",
                    "anchor",
                    "occurrence"
                  ],
                  "additionalProperties": false
                },
                "role": {
                  "enum": [
                    "content",
                    "next-episode"
                  ]
                },
                "execution": {
                  "type": "object",
                  "properties": {
                    "capability": {
                      "type": "string",
                      "minLength": 1
                    },
                    "elements": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      },
                      "minItems": 1
                    },
                    "durationFrames": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "from": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    },
                    "to": {
                      "type": "object",
                      "properties": {
                        "x": {
                          "type": "number"
                        },
                        "y": {
                          "type": "number"
                        }
                      },
                      "required": [
                        "x",
                        "y"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "required": [
                    "capability",
                    "elements",
                    "durationFrames"
                  ],
                  "additionalProperties": false
                },
                "shotId": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "id",
                "before",
                "action",
                "after",
                "trigger",
                "execution",
                "shotId"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "holds": {
            "type": "string",
            "minLength": 1
          },
          "handoff": {
            "type": "string",
            "minLength": 1
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "implementation": {
            "type": "string",
            "minLength": 1
          },
          "diagrams": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "path",
                "caption"
              ],
              "additionalProperties": false
            },
            "minItems": 0
          },
          "shots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "purpose": {
                  "type": "string",
                  "minLength": 1
                },
                "framing": {
                  "type": "string",
                  "minLength": 1
                },
                "composition": {
                  "type": "string",
                  "minLength": 1
                },
                "viewpoint": {
                  "type": "string",
                  "minLength": 1
                },
                "focus": {
                  "type": "string",
                  "minLength": 1
                },
                "camera": {
                  "type": "string",
                  "minLength": 1
                },
                "entryState": {
                  "type": "string",
                  "minLength": 1
                },
                "exitState": {
                  "type": "string",
                  "minLength": 1
                },
                "implementation": {
                  "type": "string",
                  "minLength": 1
                },
                "visibleElementIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "minItems": 1
                },
                "start": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "scene-start",
                        "cue"
                      ]
                    },
                    "anchor": {
                      "type": "string",
                      "minLength": 1
                    },
                    "occurrence": {
                      "type": "integer",
                      "minimum": 1
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                "end": {
                  "type": "object",
                  "properties": {
                    "type": {
                      "enum": [
                        "next-shot",
                        "scene-end"
                      ]
                    },
                    "shotId": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false
                },
                "transitionToNext": {
                  "type": "object",
                  "properties": {
                    "target": {
                      "type": "object",
                      "properties": {
                        "type": {
                          "enum": [
                            "shot",
                            "scene",
                            "end"
                          ]
                        },
                        "id": {
                          "type": [
                            "string",
                            "null"
                          ]
                        }
                      },
                      "required": [
                        "type",
                        "id"
                      ],
                      "additionalProperties": false
                    },
                    "mechanism": {
                      "type": "string",
                      "minLength": 1
                    },
                    "reason": {
                      "type": "string",
                      "minLength": 1
                    },
                    "retainedElementIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "exitingElementIds": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  },
                  "required": [
                    "target",
                    "mechanism",
                    "reason",
                    "retainedElementIds",
                    "exitingElementIds"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "id",
                "purpose",
                "framing",
                "composition",
                "viewpoint",
                "focus",
                "camera",
                "entryState",
                "exitState",
                "implementation",
                "visibleElementIds",
                "start",
                "end",
                "transitionToNext"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "objective",
          "narrationRef",
          "sourceRefs",
          "focus",
          "layout",
          "elements",
          "events",
          "holds",
          "handoff",
          "assets",
          "implementation",
          "shots"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "schemaVersion",
    "videoSlug",
    "workflow",
    "productionContract",
    "style",
    "seriesSelection",
    "scenes"
  ],
  "additionalProperties": false
}
