{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-design-audit-v3",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "const": 3
    },
    "kind": {
      "const": "storyboard-design-audit"
    },
    "ruleVersion": {
      "const": "storyboard-execution-quality-v2"
    },
    "videoSlug": {
      "type": "string",
      "minLength": 1
    },
    "inputVersion": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "storyboardFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "narrationFingerprint": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewedSceneIds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "ready",
        "pending"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "sceneId": {
            "type": "string",
            "minLength": 1
          },
          "shotId": {
            "type": "string",
            "minLength": 1
          },
          "eventId": {
            "type": "string",
            "minLength": 1
          },
          "problem": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "open",
              "resolved",
              "gate-3"
            ]
          },
          "resolution": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "problem",
          "status",
          "resolution"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "kind",
    "ruleVersion",
    "videoSlug",
    "inputVersion",
    "storyboardFingerprint",
    "narrationFingerprint",
    "reviewedSceneIds",
    "status",
    "summary",
    "findings"
  ],
  "additionalProperties": false
}
